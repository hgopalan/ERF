# One circuit over the hills of Conductors_Terrain: line L1 of that case (hilltop transformer T1 to T3 on
# flat ground, three spans over two lattice towers) as three phases across the towers' cross-arms and a
# shield wire on their peaks. The middle phase L1b owns the towers; L1a, L1c and the shield wire share
# them. Written from Conductors_Terrain/network.inputs with the circuit helpers of
# Exec/CanonicalTests/PowerLines/make_case.py.
erf.conductors.lines        = L1a L1b L1c L1sw
erf.conductors.transformers = T1 T3
erf.conductors.tower_types  = lattice

# the suspension towers: square lattice, loaded by the wind on their members, bending at 2 Hz
erf.conductors.lattice.base_width = 6
erf.conductors.lattice.top_width  = 1.5
erf.conductors.lattice.solidity   = 0.2
erf.conductors.lattice.arm_length = 12
erf.conductors.lattice.arm_depth  = 1.2
erf.conductors.lattice.peak       = 8     # m of tower above the cross-arm; the shield wire is clamped 7 m up
erf.conductors.lattice.weight     = 60000
erf.conductors.lattice.allowable_uplift      = 50000
erf.conductors.lattice.allowable_compression = 150000
erf.conductors.lattice.frequency  = 2.0
erf.conductors.lattice.foundation_rotational_stiffness = 1.0e9

erf.conductors.T1.position         = 894.07 729.47
erf.conductors.T1.size             = 8 5 6
erf.conductors.T1.allowable_force  = 100000   # N: four lines of the circuit end on it
erf.conductors.T1.allowable_moment = 1000000
erf.conductors.T3.position         = 1300.28 704.86
erf.conductors.T3.size             = 8 5 6
erf.conductors.T3.allowable_force  = 100000   # N: four lines of the circuit end on it
erf.conductors.T3.allowable_moment = 1000000

erf.conductors.L1b.end_a  = 896.87 729.30 10
erf.conductors.L1b.towers = 936.93 726.87 30  1097.17 717.16 30
erf.conductors.L1b.end_b  = 1297.48 705.03 10
erf.conductors.L1b.stringing_tension = 20000
erf.conductors.L1b.diameter         = 0.0281
erf.conductors.L1b.mass_per_length  = 1.628
erf.conductors.L1b.axial_stiffness  = 3.0e7
erf.conductors.L1b.tower_type       = lattice
erf.conductors.L1b.insulator_length = 2.5
erf.conductors.L1b.insulator_mass   = 60.
erf.conductors.L1a.end_a  = 896.96 730.80 10
erf.conductors.L1a.towers = 937.26 732.36 30  1097.50 722.65 30
erf.conductors.L1a.end_b  = 1297.57 706.53 10
erf.conductors.L1a.stringing_tension = 20000
erf.conductors.L1a.diameter         = 0.0281
erf.conductors.L1a.mass_per_length  = 1.628
erf.conductors.L1a.axial_stiffness  = 3.0e7
erf.conductors.L1a.share_towers     = L1b
erf.conductors.L1a.insulator_length = 2.5
erf.conductors.L1a.insulator_mass   = 60.
erf.conductors.L1c.end_a  = 896.78 727.80 10
erf.conductors.L1c.towers = 936.60 721.38 30  1096.84 711.67 30
erf.conductors.L1c.end_b  = 1297.39 703.53 10
erf.conductors.L1c.stringing_tension = 20000
erf.conductors.L1c.diameter         = 0.0281
erf.conductors.L1c.mass_per_length  = 1.628
erf.conductors.L1c.axial_stiffness  = 3.0e7
erf.conductors.L1c.share_towers     = L1b
erf.conductors.L1c.insulator_length = 2.5
erf.conductors.L1c.insulator_mass   = 60.
# the shield wire: a steel strand, 0.0111 m in diameter for its drag, 0.406 kg/m and EA (axial
# stiffness) 9.7e6 N, strung to 10 kN
erf.conductors.L1sw.end_a  = 896.87 729.30 12
erf.conductors.L1sw.towers = 936.93 726.87 37  1097.17 717.16 37
erf.conductors.L1sw.end_b  = 1297.48 705.03 12
erf.conductors.L1sw.stringing_tension = 10000
erf.conductors.L1sw.diameter         = 0.0111
erf.conductors.L1sw.mass_per_length  = 0.406
erf.conductors.L1sw.axial_stiffness  = 9.7e6
erf.conductors.L1sw.share_towers     = L1b

# 10 segments per span instead of the default 20, for the test's short run
erf.conductors.L1a.segments = 10
erf.conductors.L1b.segments = 10
erf.conductors.L1c.segments = 10
erf.conductors.L1sw.segments = 10
