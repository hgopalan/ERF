# Haboob gust front over a Gaussian hill, with a grass fire and dust on its path.
#
# A -10 K cold pool (erf.prob_name = "Bubble", prob.* keys) sits at the
# upwind end of an 8 km x 4 km periodic domain in a 5 m/s neutral boundary
# layer. It collapses into a density current that runs downwind over a grass
# fire ignited at x = 3.5 km and then over a 200 m Gaussian hill centred at
# (5000, 2000) m. Fire, smoke and dust are two-way coupled to the atmosphere
# (coupling_type = lagged); the dust module emits from the surface wind.
#
# The bubble is placed in computational z (prob.z_c is measured from the
# bottom of the mesh, not from the ground), so it is kept over flat ground
# upwind of the hill.
#
# max_step = 20 (5 s) keeps this a short regression run. The full-length
# 600 s run and its results are described in README.md.
#
# Notes:
#   - HaboobFireFlat and HaboobFirePit run the same cold pool and fire over
#     flat ground and over a 200 m deep pit; only the terrain differs.
#   - haboob_hill_129x65.txt is written by
#     ../GaussianTerrain/make_gaussian_terrain.py (command in README.md).

erf.prob_name = "Bubble"
max_step = 20
amr.max_level = 0
amrex.fpe_trap_invalid = 0
fabarray.mfiter_tile_size = 1024 1024 1024
geometry.prob_extent = 8000.0 4000.0 1500.0
amr.n_cell = 128 64 64
geometry.is_periodic = 1 1 0
amr.max_grid_size = 32
amr.max_grid_size_z   = 64
zlo.type = "surface_layer"
erf.most.z0 = 0.1
erf.most.zref = 24.0
erf.most.surf_temp_flux = 0.0
zhi.type = "SlipWall"
zhi.theta_grad = 0.003
erf.fixed_dt = 0.25
erf.sum_interval = 20
erf.v = 1
amr.v = 1
erf.check_int = -1
erf.plot_int_1 = 20
erf.plot_vars_1 = density x_velocity y_velocity z_velocity theta smoke rhoadv_dust z_phys
erf.use_gravity = true
erf.molec_diff_type = "None"
erf.les_type = "None"
erf.init_type = "input_sounding"
erf.sounding_type = Ideal
erf.input_sounding_file = "sounding_neutral_abl"
erf.pbl_type = "MRF"
erf.pbl_mrf_Ribcr = 0.5
erf.pbl_mrf_const_b = 7.8
erf.pbl_mrf_sf = 0.1
erf.enable_mrf_countergradient = true
erf.use_coriolis = true
erf.latitude = 45.0
erf.abl_driver_type = "GeostrophicWind"
erf.transport_scalar = true

# Cold pool: a -10 K air-temperature anomaly, cos^2 in the normalised
# distance from (x_c, y_c, z_c) with radii (x_r, y_r, z_r). y_r = 4000 m
# is twice the distance to the y boundaries, so the pool spans the domain in
# y: -10 K at y = 2 km, -5 K at the periodic y boundaries (at x_c, z = 0).
prob.x_c = 1500.0
prob.y_c = 2000.0
prob.z_c = 0.0
prob.x_r = 1000.0
prob.y_r = 4000.0
prob.z_r = 600.0
prob.T_pert = -10.0
prob.T_pert_is_airtemp = true

# Terrain: 200 m Gaussian hill, sigma 600 m, centred at (5000, 2000) m
erf.terrain_type = StaticFittedMesh
erf.terrain_file_name = "haboob_hill_129x65.txt"

# Geostrophic wind
erf.abl_geo_wind = 5.0 0.0 0.0

# Dust
erf.dust.enable = true
erf.dust.dust_debug = false
erf.dust.n_size_bins = 3
erf.dust.grid_ratio = 2
erf.dust.particle_density = 2650.0
erf.dust.z0_dust = 0.01
erf.dust.silt_fraction = 0.10
erf.dust.threshold_A_coeff = 0.1
erf.dust.alpha_crust = 0.5
erf.dust.alpha_efflor = 0.3
erf.dust.test_ustar = 0.0
erf.dust.rho_air = 1.225
erf.dust.zref = 24.0
erf.dust.supp_tau_base_s = 3600.0
erf.dust.test_surf_temp_K = 293.15
erf.dust.test_wind_speed = 0.0
erf.dust.atm_feedback = 1.0
erf.dust.transport_bins_separately = false
erf.dust.bin_diameters = 7.0e-6 2.5e-6 50.0e-6
erf.dust.deposition_E0 = 3.0e-3
erf.dust.loading_feedback_coeff = 0.0
erf.dust.dust_plot_int = 20
erf.dust.dust_diag_file = "dust_diag.dat"
erf.dust.phreeqc_update_interval_s = 86400.0
erf.dust.phreeqc_output_file = ""
erf.dust.soil_type_file = ""
erf.dust.silt_fraction_file = ""
erf.dust.crust_index_file = ""
erf.dust.moisture_flag_file = ""
erf.dust.suppression_file = ""
erf.dust.blast_schedule_file = ""
erf.dust.road_schedule_file = ""

# Fire: grass (fuel model 1), level-set front, two-way coupled
erf.fire.enable = true
erf.fire.fire_debug = false
erf.fire.grid_ratio = 2
erf.fire.fuel_model_id = 1
erf.fire.moisture_1hr = 0.04
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.10
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 3500.0
erf.fire.ignition_y = 2000.0
erf.fire.ignition_r = 150.0
erf.fire.propagation_method = "levelset"
erf.fire.directional_ros = true
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.use_wind_limit = true
erf.fire.heat_flux_alfg = 45.0
erf.fire.heat_flux_partition = "cfbm"
erf.fire.fire_atm_feedback = 1.0
erf.fire.inject_latent = true
erf.fire.use_terrain_wind = true
erf.fire.coupling_type = "lagged"
erf.fire.source_mode = "add"
erf.fire.smoke_enable = true
erf.fire.smoke_emission_factor = 0.02
erf.fire.smoke_heat_of_comb = 18700000.0
erf.fire.smoke_heat_from_fuel = true
erf.fire_plot_int = 20

# Fire-Dust coupling
erf.dust.crust_index = 0.5
erf.dust.use_terrain_wind = true
erf.dust.k_ridge = 1.5
erf.dust.k_shelter = 0.6
erf.dust.k_valley = 0.8
erf.fire_dust_coupling = true
erf.fire_dust_crust_reduction = 0.8
erf.fire_dust_wind_to_dust = true
erf.fire_dust_wind_z0 = 0.1
erf.fire_dust_wind_zref = 6.1
erf.fire_dust_lofting_enabled = true
erf.fire_dust_lofting_k_loft = 2.0
erf.fire_dust_lofting_Q_threshold = 50.0
erf.fire_dust_lofting_Q_ref = 500.0
