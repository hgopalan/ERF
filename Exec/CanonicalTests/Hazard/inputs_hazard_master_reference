# ============================================================================
# ERF Hazard Module: Master Inputs Configuration Reference
# ============================================================================
# Documentation only: the keys that make a coupled fire + dust (hazard) run,
# with their defaults. Every key listed here is read by the code; the full
# per-module lists are Fire/inputs_fire_master_reference (erf.fire.*) and
# Dust/inputs_dust_master_reference (erf.dust.*, generated from
# Docs/sphinx_doc/tools/gen_dust_inputs.py). ParmParse never warns about a
# key nothing reads, so check the unused-keys table AMReX prints at exit.
# ============================================================================

# ============================================================================
# CORE GEOMETRY AND ATMOSPHERIC SETUP
# ============================================================================
# Standard domain, mesh, time stepping and surface layer: see the fire master
# reference. Both modules need zlo.type = "surface_layer" and whole columns
# in z (amr.max_grid_size_z = the domain's number of cells in z).

# ============================================================================
# MODULE SWITCHES
# ============================================================================
erf.fire.enable = true
erf.dust.enable = false          # needs a build with ERF_ENABLE_DUST=ON

# Both layers live on their own finer 2D grid; the coupling requires the two
# ratios to be equal (checked at start-up).
erf.fire.grid_ratio = 1
erf.dust.grid_ratio = 1

# ============================================================================
# FIRE SUB-MODULE (ABBREVIATED)
# ============================================================================
erf.fire.fuel_model_id = 8       # Anderson FBFM13 model (1-13)
erf.fire.moisture_1hr = 0.08     # dead fuel moisture fractions
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.08
erf.fire.use_terrain_wind = true # FARSITE terrain wind corrections on the fire grid

# Wind: the fire reads the atmosphere's wind at erf.fire.wind_ref_ht; there is
# no fire-side constant wind. Set it through the atmosphere (sounding, inflow
# profile or uniform init).

# Smoke tracer emitted by the fire (advected as a scalar in the atmosphere)
erf.fire.smoke_enable = false
erf.fire.smoke_emission_factor = 0.02      # kg smoke per kg fuel burned
erf.fire.smoke_heat_of_comb = 18700000.0   # J/kg, converts heat flux to fuel burned
erf.fire.smoke_heat_from_fuel = false      # emit from the fuel consumed instead of the heat flux

# ============================================================================
# DUST SUB-MODULE (ABBREVIATED)
# ============================================================================
erf.dust.n_size_bins = 3
erf.dust.bin_diameters = 7.0e-6 2.5e-6 50.0e-6   # [m]; bin 0 sets the threshold u*
erf.dust.z0_dust = 0.01          # roughness of the emitting surface [m]
erf.dust.zref = 10.0             # wind extraction height [m]; must equal erf.most.zref
erf.dust.atm_feedback = 1.0      # 1 = dust returns to the atmosphere as a scalar, 0 = passive
erf.dust.transport_bins_separately = false
erf.dust.deposition_E0 = 3.0e-3  # dry-deposition efficiency; 0 turns deposition off (mass-conservation case)

# Terrain wind corrections on the dust grid (same factors as the fire ones)
erf.dust.use_terrain_wind = false
erf.dust.terrain_file = ""       # ESRI ASCII raster on the dust grid; empty = the atmosphere terrain
erf.dust.k_ridge = 1.5
erf.dust.k_shelter = 0.6
erf.dust.k_valley = 0.8
erf.dust.k_deflect = 0.3

# ============================================================================
# FIRE-DUST COUPLING (erf.* keys, read only when both layers exist)
# ============================================================================
erf.fire_dust_coupling = false           # master switch
erf.fire_dust_crust_reduction = 0.8      # fraction of the soil crust removed in burned cells
erf.fire_dust_wind_to_dust = true        # hand the fire-grid wind to the dust threshold
erf.fire_dust_wind_z0 = 0.1              # roughness of the log law used for that wind [m]
erf.fire_dust_wind_zref = 6.1            # its reference height; match erf.fire.wind_ref_ht [m]
erf.fire_dust_lofting_enabled = false    # loft dust in the fire plume
erf.fire_dust_lofting_k_loft = 2.0       # lofting strength
erf.fire_dust_lofting_Q_threshold = 50.0 # fire heat flux that starts lofting [W/m2]
erf.fire_dust_lofting_Q_ref = 500.0      # heat flux of unit lofting [W/m2]

# ============================================================================
# TERRAIN
# ============================================================================
# The Hazard cases use ERF's terrain-fitted mesh with a raster file; the
# Gaussian hill and pit rasters are in Hazard/GaussianTerrain.
# erf.terrain_type = StaticFittedMesh
# erf.terrain_file_name = "../GaussianTerrain/gaussian_hill_32x32.txt"
# erf.terrain_smoothing = 1

# ============================================================================
# HEALTH AND REGULATORY DIAGNOSTICS (dust module; see the dust master reference
# for the NAAQS / PM output keys)
# ============================================================================
erf.dust.msha_pel_mg_m3 = 5.0
erf.dust.msha_shift_duration_s = 28800.0
erf.dust.msha_exposure_file = "msha_exposure.csv"
erf.dust.msha_shift_file = "msha_shift_summary.csv"
erf.dust.stel_enable = false
erf.dust.stel_threshold_mg_m3 = 10.0
erf.dust.stel_averaging_s = 900.0
erf.dust.stel_diag_file = "stel_diag.csv"
erf.dust.silica_enable = false
erf.dust.silica_fraction_rcs = 0.04
erf.dust.silica_osha_pel_mg_m3 = 0.05
erf.dust.silica_diag_file = "silica_diag.csv"
erf.dust.visibility_enable = false
erf.dust.visibility_k_ext = 4.0e3
erf.dust.visibility_road_closure_m = 300.0
erf.dust.visibility_warning_m = 1000.0
erf.dust.visibility_diag_file = "visibility_diag.csv"

# ============================================================================
# OUTPUT
# ============================================================================
erf.fire_plot_int = -1           # fire-grid plotfiles (plt_fire_*), -1 = off
erf.dust.dust_plot_int = -1      # dust-grid plotfiles, -1 = off
erf.dust.dust_debug = false      # per-step dust diagnostics
erf.fire.fire_debug = false      # per-step fire diagnostics

# The haboob cases (Hazard/HaboobFire*) are ordinary sounding-initialised
# runs; there are no haboob-specific keys. Mass conservation is checked by
# the FireDustMassConservation case's script, not by an input.
