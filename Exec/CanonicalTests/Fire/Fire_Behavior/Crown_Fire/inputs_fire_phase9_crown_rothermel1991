# Crown fire with the Rothermel (1991) active crown ROS correlation.
#
# Same canopy and surface setup as inputs_fire_phase9_crown, which uses the
# Cruz correlation, so the two isolate the choice of active crown ROS model.
# Rothermel (1991) scales the active crown rate directly from the surface rate
# and takes no wind or canopy bulk density argument.
#
# Expected result:
#   - Crowning initiates at the same cells as the Cruz case, since the Van
#     Wagner initiation criterion is unchanged.
#   - The active crown spread rate differs from Cruz, and being surface-driven
#     it tracks changes in surface ROS more closely.
#   - Crown-enhanced spread reaches the fire front: the enhancement is applied
#     before propagation, so the perimeter differs from the surface-only case.
#
# Configuration:
#   - crown.ros_model = "rothermel1991"; canopy properties unchanged.
#
# Notes:
#   - Compare perimeter and fireline intensity against inputs_fire_phase9_crown
#     and inputs_fire_phase9_surface_only.
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 100
amr.max_grid_size_z = 50

zlo.type = "surface_layer"
zhi.type = "SlipWall"

erf.most.z0 = 0.1
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.rans_type = "None"
erf.init_type = "uniform"
erf.theta_ref = 300.0
# Wind: geostrophic forcing, and the generic problem starts the flow in
# geostrophic balance so the driver holds this wind rather than building it.
# (erf.geostrophic_wind_x/y, used here before 2026-09-10, was read by nothing.)
erf.abl_driver_type = "GeostrophicWind"
erf.abl_geo_wind = 10.0 0.0 0.0
erf.use_coriolis = true

# CFL-controlled step. A fixed 1.0 s was 2.4 times the compressible limit of
# about 0.41 s on this grid, and every deck coupling the fire back crashed on it.
erf.cfl = 0.5
stop_time = 900.0
max_step = 6000

erf.sum_interval = 50
erf.v = 1
amr.v = 1
erf.check_int = -1
# No atmosphere plotfiles: nothing reads them, the check script uses the fire
# plotfiles. (erf.plot_int/erf.plot_vars, set here before 2026-09-10, were read
# by nothing, so none was written either; ERF reads erf.plot_int_1/plot_vars_1.)
erf.plot_int_1 = -1
erf.fire_plot_file = plt_fire_phase9_crown_rothermel1991_
erf.fire_plot_int = 100

erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 5
erf.fire.fuel_model_id = 8
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.10
erf.fire.moisture_100hr = 0.12
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 500.0
erf.fire.ignition_y = 1000.0
erf.fire.ignition_r = 30.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false
erf.fire.farsite.cfl_fire = 0.5
erf.fire.coupling_type = "lagged"
erf.fire.write_fire_stats_csv = true
erf.fire.flame_temp_method = "byram_radiant"
erf.fire.compute_flame_tilt = true
erf.fire.flame_tilt_T_amb = 300.0
erf.fire.flame_tilt_rho_air = 1.2

erf.fire.crown.canopy_base_ht = 5.0
erf.fire.crown.canopy_bulk_den = 0.20
erf.fire.crown.canopy_depth = 10.0
erf.fire.crown.foliar_moisture = 1.00
erf.fire.crown.M_c = 0.30
erf.fire.crown.h_crown_BTU_lb = 8000.0
erf.fire.crown.wind_10m_kmh = 30.0
erf.fire.crown.ros_model = "rothermel1991"
erf.fire.crown.use_passive_blend = false
erf.fire.crown.enable = true
erf.fire.fire_stats_csv_file = "fire_stats_phase9_crown_rothermel1991.csv"
