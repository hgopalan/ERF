# Moisture_Relaxation: dead fuel drying in dry air, and the fire it releases.
#
# Short grass (Anderson fuel model 1) starts at 20 % moisture, above its 12 %
# moisture of extinction, in still, dry air at 300 K. The time-lag model relaxes
# each dead class towards the equilibrium moisture with its own time constant,
# and Rothermel, rebuilt from the moisture each step, spreads the ignition disc
# only once the 1-hour class has dried below extinction. The atmosphere is at
# rest (slip walls on the sides and top, no gravity, no diffusion, no moisture
# model), so the air temperature and humidity the fuel sees never change.

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 400.0 400.0 100.0
amr.n_cell = 20 20 5
geometry.is_periodic = 0 0 0
amr.max_level = 0
amr.max_grid_size = 10      # box lengths must divide by the fire grid ratio
amr.max_grid_size_z = 5     # the fire module forbids z-decomposition

xlo.type = "SlipWall"
xhi.type = "SlipWall"
ylo.type = "SlipWall"
yhi.type = "SlipWall"
zlo.type = "surface_layer"  # the fire module needs the surface layer at the ground
zhi.type = "SlipWall"
erf.most.z0 = 0.1
erf.most.surf_temp = 300.0
erf.most.surf_heating_rate = 0.0

# The surface layer needs a diffusion operator; zero coefficients keep it idle.
erf.molec_diff_type = "ConstantAlpha"
erf.dynamic_viscosity = 0.0
erf.alpha_T = 0.0
erf.alpha_C = 0.0
erf.les_type = "None"

erf.init_type = "uniform"
erf.use_gravity = false
erf.use_coriolis = false
erf.theta_ref = 300.0
erf.fixed_dt = 5.0
erf.substepping_cfl = 0.5
max_step = 1440
stop_time = 7200.0          # two hours
erf.v = 0
amr.v = 0
erf.sum_interval = -1
erf.check_int = -1
erf.plot_int_1 = -1
erf.fire_plot_file = "plt_fire_"
erf.fire_plot_int = 120     # every 10 minutes

erf.fire.enable = true
erf.fire.grid_ratio = 10              # 2 m fire cells
erf.fire.propagation_method = "levelset"
erf.fire.ros_model = "rothermel"
erf.fire.coupling_type = "passive"    # one-way: the atmosphere never sees the fire
erf.fire.fuel_model_id = 1            # short grass: all of its dead load is 1-hour fuel
erf.fire.moisture_dynamic = true
erf.fire.moisture_model = "timelag"
erf.fire.moisture_1hr = 0.20          # initial moisture of every dead class
erf.fire.moisture_10hr = 0.20
erf.fire.moisture_100hr = 0.20
erf.fire.use_waf = false
erf.fire.use_wind_limit = false
erf.fire.use_terrain_wind = false
erf.fire.write_fire_stats_csv = false
erf.fire.ignition_x = 200.0
erf.fire.ignition_y = 200.0
erf.fire.ignition_r = 8.0
