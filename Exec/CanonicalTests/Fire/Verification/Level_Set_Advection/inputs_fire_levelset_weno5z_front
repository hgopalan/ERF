# Level-set fire-front propagation with the default hybrid derivatives:
# HJ-WENO5-Z within four cells of the front, first order elsewhere
# (erf.fire.levelset.gradient = weno5z_front, the WRF-Fire scheme).
# run_compare.sh runs this deck against the first-order baseline and the
# WENO-everywhere deck and prints the burned-cell counts against the
# analytic front.
#
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 100
amr.max_grid_size_z = 50

zlo.type = "surface_layer"
zhi.type = "SlipWall"

erf.most.z0 = 0.1
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.rans_type = "None"
erf.init_type = "uniform"
erf.theta_ref = 300.0
# Wind: geostrophic forcing, and the generic problem starts the flow in
# geostrophic balance so the driver holds this wind rather than building it.
# (erf.geostrophic_wind_x/y, used here before 2026-09-10, was read by nothing.)
erf.abl_driver_type = "GeostrophicWind"
erf.abl_geo_wind = 5.0 0.0 0.0
erf.use_coriolis = true

# CFL-controlled step. A fixed 1.0 s was 2.4 times the compressible limit of
# about 0.41 s on this grid, and every deck coupling the fire back crashed on it.
erf.cfl = 0.5
stop_time = 600.0
max_step = 4000

erf.sum_interval = 50
erf.v = 1
amr.v = 1
erf.check_int = -1
# No atmosphere plotfiles: nothing reads them, the check script uses the fire
# plotfiles. (erf.plot_int/erf.plot_vars, set here before 2026-09-10, were read
# by nothing, so none was written either; ERF reads erf.plot_int_1/plot_vars_1.)
erf.plot_int_1 = -1
erf.fire_plot_file = plt_fire_levelset_weno5z_front_
erf.fire_plot_int = 100

erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 5
erf.fire.fuel_model_id = 1
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.10
erf.fire.moisture_100hr = 0.12
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 1000.0
erf.fire.ignition_y = 1000.0
erf.fire.ignition_r = 30.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false
erf.fire.ros_model = "rothermel"
erf.fire.farsite.cfl_fire = 0.5
erf.fire.coupling_type = "passive"
erf.fire.write_fire_stats_csv = true
erf.fire.flame_temp_method = "byram_radiant"
erf.fire.compute_flame_tilt = false
erf.fire.fire_stats_csv_file = "fire_stats_levelset_baseline.csv"

# ---------------------------------------------------------------------------
# Level-set propagation
# ---------------------------------------------------------------------------
erf.fire.propagation_method = "levelset"
erf.fire.levelset.cfl = 0.4              # subcycle CFL; must be > 0
erf.fire.levelset.eps_visc = 0.4         # artificial viscosity on the Laplacian
erf.fire.levelset.reinit_every = 5        # reinitialize every N subcycles; must be >= 1
erf.fire.levelset.reinit_iters = 100      # must converge over the burn; see header
erf.fire.levelset.gradient = weno5z_front
erf.fire.levelset.eps_visc_front = -1.0    # single viscosity everywhere: the scheme these numbers were measured with
erf.fire.levelset.reinit_dtau = -1.0     # <= 0 selects 0.5*min(dx,dy)
