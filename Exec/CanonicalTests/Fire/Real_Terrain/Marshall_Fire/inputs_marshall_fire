# The Marshall Fire (Boulder County, Colorado, 30 December 2021) as a
# fire-in-a-windstorm demonstration on real terrain.
#
# A 25.6 x 25.6 km domain at 100 m over the SRTM1 elevation between the
# Front Range foothills (west edge) and the plains of Superior, Louisville and
# Broomfield, a fully compressible atmosphere on a terrain-fitted mesh whose
# first cell is 10 m thick and stretches by 1.1 per level to a top 4.4 km above
# the domain floor, mass inflow on the west and north faces (a neutral log law
# reaching 35 m/s, from 285 degrees) and pressure outflow on the east and
# south. The fire starts where the first Marshall Fire did, at the foot of the
# foothills on Marshall Mesa, and two more starts follow on terrain of
# opposite curvature: a convex crest on the foothill front at 300 s and a
# concave drainage east of the origin at 600 s. Short grass, 4 % dead moisture,
# Rothermel with its wind limit, spotting on. The level set runs on a 25 m
# fire grid (1024 x 1024 cells).
#
# Inputs are generated by gen_marshall.py; README.md describes the case and
# make_gif.py turns the fire plotfiles into an animation.

# ============================================================================
# GEOMETRY
# ============================================================================
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 25600.0 25600.0 4430.0     # z: 40 levels from 10 m stretched by 1.1
amr.n_cell = 256 256 40

geometry.is_periodic = 0 0 0

xlo.type = "Inflow"
xlo.dirichlet_file = "inflow_xlo.txt"
xhi.type = "Outflow"
yhi.type = "Inflow"
yhi.dirichlet_file = "inflow_yhi.txt"
ylo.type = "Outflow"

amr.max_level = 0
amr.max_grid_size   = 64     # 16 boxes; box lengths divide by grid_ratio
amr.max_grid_size_z = 40     # fire module forbids z-decomposition

erf.initial_dz            = 10.0
erf.grid_stretching_ratio = 1.1

# ============================================================================
# ATMOSPHERE
# ============================================================================
erf.anelastic = 0                 # fully compressible
# The terrain-aware limits ERF reports at start-up are 0.46 s advective and
# 0.11 s acoustic (35 m/s over 10 m cells on 0.48 slopes); 0.3 s keeps the
# slow step at CFL 0.65 and the acoustic substepping is chosen automatically.
erf.fixed_dt = 0.3

zlo.type = "surface_layer"
zhi.type = "SlipWall"
erf.most.z0 = 0.1
erf.most.surf_temp = 300.0
erf.most.surf_heating_rate = 0.0

erf.molec_diff_type = "None"
erf.les_type = "Smagorinsky"
erf.Cs = 0.1

erf.use_gravity = true
erf.use_coriolis = false
erf.theta_ref = 300.0

erf.dycore_horiz_adv_type  = "Upwind_5th"
erf.dycore_vert_adv_type   = "Upwind_3rd"
erf.dryscal_horiz_adv_type = "Upwind_5th"
erf.dryscal_vert_adv_type  = "Upwind_3rd"

# Rayleigh damping of w in the top 500 m against mountain-wave reflection
erf.rayleigh_damp_W   = true
erf.rayleigh_dampcoef = 0.2
erf.rayleigh_zdamp    = 500.0

erf.init_type = "input_sounding"
erf.input_sounding_file = "sounding_marshall.txt"
erf.sounding_type = Ideal

erf.terrain_type = StaticFittedMesh
erf.terrain_file_name = "terrain_marshall.txt"

# ============================================================================
# TIME STEPPING AND OUTPUT
# ============================================================================
stop_time = 7200.0
max_step  = 24000

erf.sum_interval = 2000
erf.v = 1
amr.v = 1

erf.check_file = chk_marshall
erf.check_int  = 12000

erf.plot_file = plt3d_marshall
erf.plot_int  = 2000              # every 10 min
erf.plot_vars = theta u v w z_phys

erf.fire_plot_file = plt_fire_
erf.fire_plot_int  = 400          # one frame every two minutes

# ============================================================================
# FIRE MODULE
# ============================================================================
erf.fire.enable = true
erf.fire.fire_debug = false
erf.fire.grid_ratio = 4               # 25 m fire cells
erf.fire.coupling_type = "passive"
erf.fire.propagation_method = "levelset"

erf.fire.fuel_model_id = 1            # short grass, cured
erf.fire.moisture_1hr = 0.04
erf.fire.moisture_10hr = 0.05
erf.fire.moisture_100hr = 0.07
erf.fire.moisture_dynamic = false

# The fire grid reads the same 50 m raster at its own 25 m spacing
erf.fire.terrain_file_name = "terrain_marshall.txt"

# First ignition: Eldorado Springs Drive at CO-93, 39.953 N 105.232 W
erf.fire.ignition_x = 5000.0
erf.fire.ignition_y = 11000.0
erf.fire.ignition_r = 100.0
# Two more starts on a convex crest and in a concave drainage
erf.fire.ignition.schedule_file = "ignitions_marshall.csv"

erf.fire.wind_ref_ht = 6.1
erf.fire.wind_interp = "bilinear"
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false     # the terrain flow is resolved

erf.fire.spotting.enable = true
erf.fire.spotting.spotting_interval = 20
erf.fire.spotting.P_base = 0.01
erf.fire.spotting.random_seed = 20211230
erf.fire.spotting.terminal_velocity = 1.5
erf.fire.spotting.spot_radius = 30.0
