# WUI_Subdivision: a wind-driven grass fire running into a subdivision.
#
# 960 x 480 x 240 m, 10 m atmosphere cells, 5 m fire cells; a neutral 10 m/s
# sounding entering at the west face and leaving at the east face, periodic
# in y; FM1 short grass at 6% moisture; a 40 m ignition disc at x = 340 m.
# Three rows of eight 20 m houses stand at x = 520, 600 and 680 m on a 60 m
# pitch, each pitch a house, a 20 m grass lane and a 20 m east-west street,
# so the lanes carry the fire through the rows (gen_wui.py draws them). The variants in this
# directory include this file and add the structures, the fuel map, the
# defensible space and the immersed-forcing buildings with heat coupling.
#
#   ./run_wui.sh /path/to/erf_exec     runs the four variants and check_wui.py

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 960.0 480.0 240.0
amr.n_cell = 96 48 24

geometry.is_periodic = 0 1 0
xlo.type = "Inflow"
xlo.velocity = 10.0 0.0 0.0
xlo.theta = 300.0
xlo.density = 1.16144
xhi.type = "Outflow"
zlo.type = "surface_layer"
zhi.type = "SlipWall"

amr.max_level = 0
amr.max_grid_size = 48      # box lengths must divide by the fire grid ratio
amr.max_grid_size_z = 24    # the fire module forbids z decomposition

erf.most.z0 = 0.1
erf.most.surf_temp = 300.0
erf.most.surf_heating_rate = 0.0

erf.molec_diff_type = "None"
erf.les_type = "Smagorinsky"
erf.Cs = 0.1
erf.use_gravity = true
erf.use_coriolis = false
erf.theta_ref = 300.0

erf.init_type = "input_sounding"
erf.input_sounding_file = "input_sounding"
erf.sounding_type = Ideal

erf.fixed_dt = 0.25
erf.substepping_cfl = 0.5
stop_time = 2100.0
max_step = 8400

erf.v = 0
amr.v = 0
erf.sum_interval = -1
erf.check_int = -1
erf.plot_int = -1
erf.fire_plot_int = 400            # every 100 s

erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 2            # 5 m fire cells
erf.fire.propagation_method = "levelset"
erf.fire.directional_ros = true
erf.fire.ros_model = "rothermel"
erf.fire.fuel_model_id = 1         # short grass
erf.fire.moisture_1hr = 0.06
erf.fire.moisture_10hr = 0.07
erf.fire.moisture_100hr = 0.09
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 340.0
erf.fire.ignition_y = 240.0
erf.fire.ignition_r = 40.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false
erf.fire.coupling_type = "passive"
erf.fire.write_fire_stats_csv = true
# Arrival probes along the centreline: three in the wildland, one at each
# house row, one beyond the last street.
erf.fire.probes = 400.0 240.0  450.0 240.0  500.0 240.0 \
                  560.0 240.0  640.0 240.0  720.0 240.0  780.0 240.0
