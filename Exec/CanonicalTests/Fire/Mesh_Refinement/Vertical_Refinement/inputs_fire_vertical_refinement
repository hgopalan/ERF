# Demonstrate vertically refined atmospheric mesh for fire.
#
# This case documents a fire configuration with enhanced vertical resolution, used to confirm that the model setup and boundary conditions remain valid under refined z discretization.
#
# Expected result:
#   - Simulation completes with the refined vertical mesh configuration.
#   - Results remain qualitatively consistent with coarser baselines while resolving more vertical structure.
#
# Configuration:
#   - Vertical grid spacing / domain height differ from simpler baseline cases.
#   - Fire and atmospheric controls otherwise remain conventional.
#
# Notes:
#   - Useful when checking vertical-resolution sensitivity of coupled plume response.

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 1000.0
amr.n_cell       = 40 40 64

# Periodic in x and y like the other fire canonical decks. This was 0 0 0
# with no xlo/xhi/ylo/yhi types, which ERF rejects ("This BC type is
# unknown"), so the deck had never run.
geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size   = 100
amr.max_grid_size_z = 64

erf.initial_dz              = 4.0
erf.grid_stretching_ratio   = 1.08

zlo.type = "surface_layer"
erf.most.z0 = 0.1
zhi.type = "SlipWall"

erf.init_type = "uniform"
erf.theta_ref = 300.0
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
# No gravity, like the other uniform-init fire decks: erf.init_type = "uniform"
# is a constant-density state, which ERF only accepts without gravity or when
# anelastic, so use_gravity = true aborted at initialisation.

# CFL-controlled step. A fixed 1.0 s was 2.4 times the compressible limit of
# about 0.41 s on this grid, and a coupled fire crashes on it.
erf.cfl = 0.5
stop_time    = 900.0
max_step     = 6000

erf.sum_interval = 10
erf.v   = 1
amr.v   = 1

erf.check_file  = chk_vref
erf.check_int   = -1

# Plot files (2D fire variables on fire grid)
erf.fire_plot_file = plt_fire_
erf.fire_plot_int  = 100


erf.fire.enable         = true
erf.fire.fire_debug     = true
erf.fire.grid_ratio     = 5
erf.fire.fuel_model_id  = 1
erf.fire.moisture_1hr   = 0.08
erf.fire.moisture_10hr  = 0.08
erf.fire.moisture_100hr = 0.10
erf.fire.ignition_x     = 1000.0
erf.fire.ignition_y     = 1000.0
erf.fire.ignition_r     = 50.0
erf.fire.wind_ref_ht    = 6.1
erf.fire.use_waf        = true
erf.fire.waf_formula    = "andrews"
erf.fire.use_wind_limit = false
erf.fire.use_terrain_wind = false
