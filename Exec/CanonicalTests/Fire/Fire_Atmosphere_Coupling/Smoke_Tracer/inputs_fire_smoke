# Smoke tracer emission from fire heat release.
#
# Injects a passive smoke scalar proportional to the fire sensible heat flux,
# carried as an extra conserved component and advected by the dycore.
#
# Expected result:
#   - Smoke appears only where the fire is burning and is advected downwind.
#   - Column-integrated smoke grows while fuel is being consumed and levels off
#     once the fuel behind the front is exhausted.
#
# Configuration:
#   - Lagged coupling so the fire releases heat into the atmosphere.
#   - smoke_emission_factor converts heat release to smoke mass; heat_of_comb
#     sets the heat released per unit fuel.
#
# Notes:
#   - Smoke adds a conserved component, so plotfile component counts differ
#     from the non-smoke cases.
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 100
amr.max_grid_size_z = 50

zlo.type = "surface_layer"
zhi.type = "SlipWall"

erf.most.z0 = 0.1
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.rans_type = "None"
# WENO-Z for the passive scalars, which include smoke; theta and momentum keep
# the dycore scheme. The default Upwind_3rd rings next to the one-layer surface
# source. Once the plume lifted that ringing, the negative smoke mass reached
# 18% of the positive mass in 60 s, against 2% with gravity off. With WENOZ5 it
# rounds to zero, and the plume, the fire and the smoke total are unchanged.
erf.dryscal_horiz_adv_type = "WENOZ5"
erf.dryscal_vert_adv_type  = "WENOZ5"
# Neutral 300 K with a uniform 5 m/s westerly (input_sounding), in hydrostatic
# balance with gravity on, so the fire's heat drives a buoyant plume that lofts
# the smoke.
# Until 2026-09-10 this deck set erf.init_type = "uniform", which runs with
# gravity off (erf.use_gravity defaults to false, and uniform init allows
# gravity only when anelastic), so the heat warmed the air but raised no plume.
erf.use_gravity = true
erf.init_type = "input_sounding"
erf.input_sounding_file = "input_sounding"
erf.sounding_type = Ideal
erf.theta_ref = 300.0
# Wind: the sounding starts the flow at the geostrophic wind, and the
# geostrophic forcing holds it against surface drag.
# (erf.geostrophic_wind_x/y, used here before 2026-09-10, was read by nothing.)
erf.abl_driver_type = "GeostrophicWind"
erf.abl_geo_wind = 5.0 0.0 0.0
erf.use_coriolis = true

# CFL-controlled step. A fixed 1.0 s was 2.4 times the compressible limit of
# about 0.41 s on this grid, and every deck coupling the fire back crashed on it.
erf.cfl = 0.5
stop_time = 900.0
max_step = 6000

erf.sum_interval = 50
erf.v = 1
amr.v = 1
erf.check_int = -1
# Atmosphere plotfiles plt_1_NNNNN carry the smoke mass concentration [kg/m^3]
# that check_smoke_tracer.py reads. (erf.plot_int/erf.plot_vars, used here
# before 2026-09-10, were read by nothing, so no atmosphere plotfile was written.)
erf.plot_int_1 = 500
erf.plot_vars_1 = density theta x_velocity y_velocity z_velocity smoke
erf.fire_plot_file = plt_fire_smoke_
erf.fire_plot_int = 100

erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 5
erf.fire.fuel_model_id = 1
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.10
erf.fire.moisture_100hr = 0.12
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 1000.0
erf.fire.ignition_y = 1000.0
erf.fire.ignition_r = 30.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false
erf.fire.ros_model = "rothermel"
erf.fire.farsite.cfl_fire = 0.5
erf.fire.coupling_type = "lagged"
erf.fire.write_fire_stats_csv = true
erf.fire.flame_temp_method = "byram_radiant"
erf.fire.compute_flame_tilt = false
erf.fire.fire_stats_csv_file = "fire_stats_smoke.csv"

# ---------------------------------------------------------------------------
# Smoke tracer
# ---------------------------------------------------------------------------
erf.fire.smoke_enable = true
erf.fire.smoke_emission_factor = 0.015     # kg smoke per kg fuel burned
erf.fire.smoke_heat_of_comb = 18600000.0   # heat of combustion [J/kg]
