# Validate synchronous fire-atmosphere coupling setup.
#
# This case exercises the tighter synchronous coupling pathway between fire and atmosphere, where fire uses the updated atmospheric state more directly than in the lagged configuration.
#
# Expected result:
#   - Simulation remains stable with synchronous coupling enabled.
#   - Atmospheric response is more immediate than in the lagged baseline while preserving physically plausible evolution.
#
# Configuration:
#   - Fire-atmosphere coupling type is set to synchronous.
#   - Domain and ignition settings mirror the coupled baseline where possible.
#
# Notes:
#   - Direct comparison with Lagged_Coupling highlights sensitivity to coupling chronology.

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 100
amr.max_grid_size_z = 50

zlo.type = "surface_layer"
zhi.type = "SlipWall"

erf.most.z0 = 0.1

erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.init_type = "uniform"
erf.theta_ref = 300.0

# CFL-controlled step. A fixed 1.0 s was 2.4 times the compressible limit of
# about 0.41 s on this grid, and the deck crashed on it once the fire coupled back.
erf.cfl = 0.5
stop_time = 1800.0
max_step = 12000

erf.sum_interval = 100
erf.v = 1
amr.v = 1
erf.check_int = -1

# Plot files (2D fire variables on fire grid)
erf.fire_plot_file = plt_fire_
erf.fire_plot_int  = 100

# Plot files (3D atmospheric variables): the plume, about every 300 s at the
# 0.22 s starting step. (erf.plot_int/erf.plot_vars, set here before 2026-09-10,
# were read by nothing, so no atmosphere plotfile was written; u, v and w
# are not plot variables of this dry run.)
erf.plot_int_1 = 1350
erf.plot_vars_1 = theta x_velocity y_velocity z_velocity

# The fire fields are in the plt_fire_ plotfiles above. An erf.plot2d_* block
# here until 2026-09-10 wrote nothing: set 1 had no variable list, and set 2
# listed fire_* names that are not 2D plot variables (18 start-up warnings).

erf.fire.enable             = true
erf.fire.fire_debug         = false
erf.fire.grid_ratio         = 5
erf.fire.fuel_model_id      = 1
erf.fire.moisture_1hr       = 0.08
erf.fire.moisture_10hr      = 0.08
erf.fire.moisture_100hr     = 0.10
erf.fire.moisture_dynamic   = false
erf.fire.ignition_x         = 1000.0
erf.fire.ignition_y         = 1000.0
erf.fire.ignition_r         = 20.0
erf.fire.use_terrain_wind   = false
erf.fire.farsite.cfl_fire   = 0.5

# Phase 7: synchronous coupling
erf.fire.coupling_type      = "synchronous"
erf.fire.heat_flux_alfg     = 45.0
erf.fire.fire_atm_feedback  = 1.0
erf.fire.inject_latent      = true

erf.fire.write_fire_stats_csv = true
erf.fire.fire_stats_csv_file  = "fire_stats_phase7.csv"
