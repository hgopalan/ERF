# Compare stable and unstable atmospheric stratification effects on fire.
#
# These cases isolate the role of background atmospheric stability in modulating fire behavior, plume response, and near-surface winds.
#
# Expected result:
#   - Stable and unstable cases produce visibly different atmospheric response and fire evolution.
#   - Both runs remain valid references for atmosphere-sensitivity studies.
#
# Configuration:
#   - Thermodynamic profile / stability settings are the primary varying controls.
#   - Fire ignition and fuels remain otherwise similar.
#
# Notes:
#   - Treat as paired comparison cases.

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

# Domain periodicity
geometry.is_periodic = 1 1 0

# No AMR
amr.max_level = 0

# Max grid size (REQUIRED for fire: no z-decomposition)
amr.max_grid_size = 100
amr.max_grid_size_z = 50

# Surface layer boundary condition (REQUIRED for fire)
zlo.type = "surface_layer"
zhi.type = "SlipWall"
zhi.theta_grad = 0.01                # hold the sounding's lapse rate at the lid

# MOST parameters (REQUIRED for fire wind extraction)
# Monin-Obukhov similarity is the surface layer's default (flux_type moeng).
# With no erf.most.surf_temp or surf_temp_flux the surface is adiabatic, so the
# stratification acts through buoyancy on the plume, not through surface fluxes.
erf.most.z0 = 0.1

# Physics
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.rans_type = "None"

# Initial conditions - Stable atmosphere: theta rises 0.01 K/m from 300 K
# (input_sounding_stable), at rest in hydrostatic balance, with gravity on.
# Until 2026-09-10 this deck set erf.init_type = "uniform" with
# erf.dtheta_ref = 0.01 and erf.most.use_monin_obukhov = true. Nothing reads
# those two keys and gravity was off, so the stable and unstable decks ran the
# same neutral, gravity-free atmosphere.
erf.use_gravity = true
erf.init_type = "input_sounding"
erf.input_sounding_file = "input_sounding_stable"
erf.sounding_type = Ideal
erf.theta_ref = 300.0

# Time stepping
# CFL-controlled step. A fixed 1.0 s was 2.4 times the compressible limit of
# about 0.41 s on this grid, and the deck crashed on it once the fire coupled back.
erf.cfl = 0.5
stop_time = 1800.0
max_step = 12000

# Diagnostics
erf.sum_interval = 100
erf.v = 1
amr.v = 1

# Checkpoints/Plots
erf.check_file = fire_chk
erf.check_int = -1

# Plot files (2D fire variables on fire grid)
erf.fire_plot_file = plt_fire_
erf.fire_plot_int  = 100


# Plot files (3D atmospheric variables): the plume, about every 300 s at the
# 0.22 s starting step. (erf.plot_int/erf.plot_vars, set here before 2026-09-10,
# were read by nothing, so no atmosphere plotfile was written; qv, u, v and w
# are not plot variables of this dry run.)
erf.plot_file_1 = plt3d_atm
erf.plot_int_1 = 1350
erf.plot_vars_1 = theta x_velocity y_velocity z_velocity

# Fire module parameters - Stable atmosphere scenario
erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 5              # 10 m × 10 m fire cells
erf.fire.fuel_model_id = 1            # GR1 (Short grass)
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.10
erf.fire.ignition_x = 1000.0
erf.fire.ignition_y = 1000.0
erf.fire.ignition_r = 20.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false
erf.fire.k_ridge = 1.5
erf.fire.k_shelter = 0.6
erf.fire.k_valley = 0.8
erf.fire.k_deflect = 0.3
