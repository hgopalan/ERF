# Canonical test for ERF-SLUCM Phase 2.3 — Facet-split Sensible Heat
# Tests: Three-facet flux decomposition (H_road, H_wall, H_roof) with area fractions
# Expected: Exit code 0, facet fluxes shown in BANNER, sum matches lumped H_sensible
#
# This test verifies:
# 1. H_sensible is split into road/wall/roof by area fractions
# 2. Anthropogenic heat (AH) is initialized to zero
# 3. plan_area_frac field properly populated from CSV
# 4. H_sensible diagnostic = H_road + H_wall + H_roof (sum invariant)
# 5. Bit-for-bit ATM regression vs Phase 2.2 (injection kernel unchanged)
# 6. Phase 2.3 BANNER shows extended diagnostics

erf.prob_name = "ABL"

# Time stepping (12 hours of simulation = 720 minutes)
max_step         = 100
erf.cfl                = 0.5
amrex.fpe_trap_invalid = 0

fabarray.mfiter_tile_size = 1024 1024 1024

# AMR / geometry (larger domain for 16×16 UCM grid)
geometry.prob_extent = 6000.0 6000.0 1024.0
amr.n_cell           = 16 16 64
amrex.max_grid_size_z = 128
geometry.is_periodic = 1 1 0

# Domain boundaries
zlo.type = "surface_layer"
erf.most.z0   = 0.1      # roughness length [m]
erf.most.zref = 24.0     # reference height [m]
erf.most.surf_temp_flux = 0.12
zhi.type = "SlipWall"
zhi.theta_grad = 0.003   # adiabatic upper boundary

# DIAGNOSTICS & VERBOSITY
erf.sum_interval   = 1
erf.v              = 1
amr.v              = 1

# REFINEMENT / REGRIDDING
amr.max_level       = 0

# CHECKPOINT / PLOTFILES
amr.plot_int         = 12    # ATM plotfile every 12 hours
amr.check_int        = -1
erf.check_int        = -1

# SOLVER CHOICE
erf.use_gravity = true
erf.molec_diff_type = "None"
# When using a PBL model, LES closure should be disabled
erf.les_type        = "None"
erf.Cs = 0.11
erf.theta_ref = 300.0

# Terrain: keep as-is (no terrain)
erf.terrain_type     = None
erf.use_moisture     = false
erf.transport_scalar = false

# INITIALIZATION - from sounding file (same as neutral_abl)
erf.init_type = "input_sounding"
erf.sounding_type = Ideal
erf.input_sounding_file = "sounding_neutral_abl"

# PBL CONFIGURATION - Baseline MRF (neutral case)
erf.pbl_type = "MRF"
erf.pbl_mrf_Ribcr = 0.5   # critical bulk Richardson number
erf.pbl_mrf_const_b = 7.8 # surface layer factor (WRF CFAC)
erf.pbl_mrf_sf = 0.1      # surface layer fraction (WRF SFAC)

# Disable countergradient corrections (not relevant for neutral conditions)
erf.enable_mrf_countergradient = true

# Enable moisture diffusivity for completeness (but no moisture in neutral case)
erf.mrf_moistvars = false

# CORIOLIS / GEOSTROPHIC FORCING
erf.latitude = 45.0
erf.use_coriolis = true
erf.abl_driver_type = "GeostrophicWind"
erf.abl_geo_wind = 15.0 0.0 0.0

# ========================================================================
# SLUCM Configuration (Phase 2.3 — Facet-split sensible heat + AH)
# ========================================================================
erf.ucm.enable              = true
erf.ucm.ucm_debug           = true
erf.ucm.anchor_level        = 0
erf.ucm.static_refinement   = true
erf.ucm.grid_ratio          = 1
erf.ucm.allow_steep_terrain = false

# Phase 1.4 injection coupling
# Two-way baseline: all feedback active.
erf.ucm.atm_feedback_momentum = 1.0
erf.ucm.atm_feedback_heat     = 1.0
erf.ucm.atm_feedback_moisture = 0.0
erf.ucm.zref                = 2.0
erf.ucm.alpha_ucm           = 15.0   # e-folding depth ~ 1.5×H_bldg

# Phase 2.2: Aerodynamic parameters (z0 and displacement height)
erf.ucm.z0_over_H           = 0.1
erf.ucm.d_over_H            = 0.7

# Phase 2.3: Facet-split and anthropogenic heat
erf.ucm.plan_area_frac_uniform = 0.5      # Default plan-area fraction [-]
erf.ucm.AH_uniform_Wm2         = 30.0      # Uniform AH for this test [W/m^2]
erf.ucm.AH_daytime_peak        = 20.0     # Peak of diurnal AH [W/m^2] (not used)
erf.ucm.AH_profile_type_default = 0       # 0 = uniform, 1 = diurnal cosine

# Phase 2.1: CSV readers for heterogeneous inputs
# Heterogeneous case: 16×16 grid with varying building height (5m and 25m)
erf.ucm.building_layout_csv_path = "building_hetero_mat.csv"
erf.ucm.material_library_csv_path = "materials.csv"

# Phase 1.4 homogeneous fallback values (not used when CSV paths specified)
erf.ucm.H_bldg_uniform      = 10.0
erf.ucm.W_road_uniform      = 10.0
erf.ucm.W_roof_uniform      = 10.0

erf.ucm.albedo_roof         = 0.20
erf.ucm.albedo_wall         = 0.20
erf.ucm.albedo_road         = 0.15

erf.ucm.emissivity_roof     = 0.90
erf.ucm.emissivity_wall     = 0.90
erf.ucm.emissivity_road     = 0.94

# Phase 2.3 diagnostics output
erf.ucm.ucm_plot_int        = 100   # Plotfile at end
erf.ucm.ucm_diag_file       = "ucm_diag.dat"

erf.ucm.test_ustar          = 0.0
# Phase 3.5a-hotfix4: Uniform SLUCM init.
# Default (unset or -1.0) auto-syncs to erf.theta_ref for exact thermal equilibrium.
# Uncomment to override:
# erf.ucm.T_init_uniform_K    = 295.0
