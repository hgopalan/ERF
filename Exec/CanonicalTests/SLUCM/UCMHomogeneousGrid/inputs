# Canonical test for ERF-SLUCM Phase 1.2
# Tests: UCM 2D grid construction with grid_ratio=2, MultiFab allocation, homogeneous fill, is_urban mask
# Expected: exit code 0 at step 2, UCM startup banner, Phase 1.2 debug messages, grid extents match 16x16x1
#
# Atmospheric setup mirrors the neutral ABL canonical test
# (Exec/CanonicalTests/ABL/MRF_Enhancements/canonical/neutral_abl),
# using an input sounding for initialization. Terrain is left as-is (none).
#
# Phase 1.2 enhancement: exercises grid_ratio=2 refinement (8x8 ATM → 16x16 UCM)

erf.prob_name = "ABL"

# Time stepping (kept short for scaffold test)
max_step         = 2
erf.cfl                = 0.5
amrex.fpe_trap_invalid = 0

fabarray.mfiter_tile_size = 1024 1024 1024

# AMR / geometry
geometry.prob_extent = 3000.0 3000.0 1024.0
amr.n_cell           = 8 8 64
amrex.max_grid_size_z = 128
geometry.is_periodic = 1 1 0

# Domain boundaries
zlo.type = "surface_layer"
erf.most.z0   = 0.1      # roughness length [m]
erf.most.zref = 24.0     # reference height [m]
erf.most.surf_temp_flux = 0.0
zhi.type = "SlipWall"
zhi.theta_grad = 0.003   # adiabatic upper boundary

# DIAGNOSTICS & VERBOSITY
erf.sum_interval   = 1
erf.v              = 1
amr.v              = 1

# REFINEMENT / REGRIDDING
amr.max_level       = 0

# CHECKPOINT / PLOTFILES (disabled for homogeneous grid test)
amr.plot_int         = -1
amr.check_int        = -1
erf.check_int        = -1

# SOLVER CHOICE
erf.use_gravity = true
erf.molec_diff_type = "None"
# When using a PBL model, LES closure should be disabled
erf.les_type        = "None"
erf.Cs = 0.11
erf.theta_ref = 300.0

# Terrain: keep as-is (no terrain)
erf.terrain_type     = None
erf.use_moisture     = false
erf.transport_scalar = false

# INITIALIZATION - from sounding file (same as neutral_abl)
erf.init_type = "input_sounding"
erf.sounding_type = Ideal
erf.input_sounding_file = "sounding_neutral_abl"

# PBL CONFIGURATION - Baseline MRF (neutral case)
erf.pbl_type = "MRF"
erf.pbl_mrf_Ribcr = 0.5   # critical bulk Richardson number
erf.pbl_mrf_const_b = 7.8 # surface layer factor (WRF CFAC)
erf.pbl_mrf_sf = 0.1      # surface layer fraction (WRF SFAC)

# Disable countergradient corrections (not relevant for neutral conditions)
erf.enable_mrf_countergradient = true

# Enable moisture diffusivity for completeness (but no moisture in neutral case)
erf.mrf_moistvars = false

# CORIOLIS / GEOSTROPHIC FORCING
erf.latitude = 45.0
erf.use_coriolis = true
erf.abl_driver_type = "GeostrophicWind"
erf.abl_geo_wind = 15.0 0.0 0.0

# ========================================================================
# SLUCM Configuration (Phase 1.2 — exercises grid_ratio = 2)
# ========================================================================
erf.ucm.enable              = true
erf.ucm.ucm_debug           = true
erf.ucm.anchor_level        = 0
erf.ucm.static_refinement   = true
erf.ucm.grid_ratio          = 2
erf.ucm.allow_steep_terrain = false

# One-way baseline: momentum drag active, heat feedback OFF.
erf.ucm.atm_feedback_momentum = 1.0
erf.ucm.atm_feedback_heat     = 0.0
erf.ucm.atm_feedback_moisture = 0.0
erf.ucm.zref                = 2.0
erf.ucm.alpha_ucm           = 10.0

erf.ucm.H_bldg_uniform      = 10.0
erf.ucm.W_road_uniform      = 10.0
erf.ucm.W_roof_uniform      = 10.0

erf.ucm.albedo_roof         = 0.20
erf.ucm.albedo_wall         = 0.20
erf.ucm.albedo_road         = 0.15

erf.ucm.emissivity_roof     = 0.90
erf.ucm.emissivity_wall     = 0.90
erf.ucm.emissivity_road     = 0.94

erf.ucm.ucm_plot_int        = -1
erf.ucm.ucm_diag_file       = "ucm_diag.dat"

erf.ucm.test_ustar          = 0.0
# Phase 3.5a-hotfix4: Uniform SLUCM init.
# Default (unset or -1.0) auto-syncs to erf.theta_ref for exact thermal equilibrium.
# Uncomment to override:
# erf.ucm.T_init_uniform_K    = 295.0
