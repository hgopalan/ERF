# Canonical test for ERF-SLUCM Phase 2.5 follow-up
# Tests: ATM-grid aggregate plotfile writing, scale-aware flux coarsening with variable f_urb
# Expected: exit code 0 at step 100, plt_ucm_atm_00100 exists, ucm_diag.dat has 4 new columns,
#           f_urb varies [0,1], H_bldg_mean ~10m in urban, conservation checks pass
#
# Grid: ATM 4x4 (small), grid_ratio=4 -> UCM 16x16 (visible refinement)
# Pattern: diagonal urban wedge, produces spectrum of f_urb values across ATM cells

erf.prob_name = "ABL"

# Time stepping
max_step         = 100
erf.cfl                = 0.5
amrex.fpe_trap_invalid = 0

fabarray.mfiter_tile_size = 1024 1024 1024

# AMR / geometry (small ATM domain to make refinement visible)
geometry.prob_extent = 400.0 400.0 1024.0
amr.n_cell           = 4 4 64
amrex.max_grid_size_z = 128
geometry.is_periodic = 1 1 0

# Domain boundaries
zlo.type = "surface_layer"
erf.most.z0   = 0.1      # roughness length [m]
erf.most.zref = 24.0     # reference height [m]
erf.most.surf_temp_flux = 0.0
zhi.type = "SlipWall"
zhi.theta_grad = 0.003   # adiabatic upper boundary

# DIAGNOSTICS & VERBOSITY
erf.sum_interval   = 1
erf.v              = 1
amr.v              = 1

# REFINEMENT / REGRIDDING
amr.max_level       = 0

# CHECKPOINT / PLOTFILES (disabled for canonical test)
amr.plot_int         = -1
amr.check_int        = -1
erf.check_int        = -1

# SOLVER CHOICE
erf.use_gravity = true
erf.molec_diff_type = "None"
# When using a PBL model, LES closure should be disabled
erf.les_type        = "None"
erf.Cs = 0.11
erf.theta_ref = 300.0

# Terrain: keep as-is (no terrain)
erf.terrain_type     = None
erf.use_moisture     = false
erf.transport_scalar = false

# INITIALIZATION - from sounding file (same as neutral_abl)
erf.init_type = "input_sounding"
erf.sounding_type = Ideal
erf.input_sounding_file = "sounding_neutral_abl"

# PBL CONFIGURATION - Baseline MRF (neutral case)
erf.pbl_type = "MRF"
erf.pbl_mrf_Ribcr = 0.5   # critical bulk Richardson number
erf.pbl_mrf_const_b = 7.8 # surface layer factor (WRF CFAC)
erf.pbl_mrf_sf = 0.1      # surface layer fraction (WRF SFAC)

# Disable countergradient corrections (not relevant for neutral conditions)
erf.enable_mrf_countergradient = true

# Enable moisture diffusivity for completeness (but no moisture in neutral case)
erf.mrf_moistvars = false

# CORIOLIS / GEOSTROPHIC FORCING
erf.latitude = 45.0
erf.use_coriolis = true
erf.abl_driver_type = "GeostrophicWind"
erf.abl_geo_wind = 15.0 0.0 0.0

# ========================================================================
# SLUCM Configuration (Phase 2.5 follow-up)
# ========================================================================
erf.ucm.enable              = true
erf.ucm.ucm_debug           = true
erf.ucm.anchor_level        = 0
erf.ucm.static_refinement   = true
erf.ucm.grid_ratio          = 4
erf.ucm.allow_steep_terrain = false

erf.ucm.atm_feedback        = 1.0
erf.ucm.zref                = 2.0
erf.ucm.alpha_ucm           = 10.0

erf.ucm.H_bldg_uniform      = 10.0
erf.ucm.W_road_uniform      = 10.0
erf.ucm.W_roof_uniform      = 10.0

erf.ucm.albedo_roof         = 0.20
erf.ucm.albedo_wall         = 0.20
erf.ucm.albedo_road         = 0.15

erf.ucm.emissivity_roof     = 0.90
erf.ucm.emissivity_wall     = 0.90
erf.ucm.emissivity_road     = 0.94

erf.ucm.ucm_plot_int        = 100
erf.ucm.ucm_atm_plot_int    = 100
erf.ucm.ucm_diag_file       = "ucm_diag.dat"

erf.ucm.test_ustar          = 0.0
erf.ucm.test_surf_temp_K    = 293.15

# CSV-based heterogeneous setup (Phase 2.1)
erf.ucm.building_layout_csv = "building_layout.csv"
erf.ucm.material_library_csv = "materials.csv"
