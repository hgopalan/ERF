# ============================================================================
# ERF dust model: master input reference
# ============================================================================
# Every dust input with its default value and a one-line description, in the
# groups of the Sphinx page Docs/sphinx_doc/Inputs.rst (section "Dust Model").
# This deck documents the keys; it is not a tuned case. With every key at its
# default the dust model is off (erf.dust.enable = false), so running it is a
# plain neutral ABL. The prerequisites of the dust model are set below so the
# deck can be used as a starting point.
#
# Generated by the parameter list in the documentation; edit the list, not
# this file, when a key changes.
# ============================================================================

# ---------------------------------------------------------------------------
# Atmosphere set-up that the dust model requires
# ---------------------------------------------------------------------------
erf.prob_name = "ABL"
geometry.prob_lo     = 0.0 0.0 0.0
geometry.prob_hi     = 3000.0 3000.0 1024.0
amr.n_cell           = 8 8 64
geometry.is_periodic = 1 1 0
amr.max_level        = 0
amr.max_grid_size    = 32
amr.max_grid_size_z  = 64            # no decomposition in z (dust prerequisite)
amrex.fpe_trap_invalid = 0

zlo.type = "surface_layer"           # a surface layer is required (u*, T_sfc, PBLH)
zhi.type = "SlipWall"
erf.most.z0   = 0.1
erf.most.zref = 24.0                 # match erf.dust.zref

erf.pbl_type   = "MRF"               # provides the PBL height and the scalar diffusivity
erf.transport_scalar = true          # the dust rides in a passive scalar
erf.molec_diff_type = "None"
erf.les_type        = "None"
erf.use_gravity = true
erf.init_type   = "input_sounding"
erf.input_sounding_file = "sounding_neutral_abl"
erf.theta_ref   = 300.0
erf.abl_geo_wind = 15.0 0.0 0.0

erf.fixed_dt = 0.5
max_step     = 20
erf.check_int = -1
erf.plot_int_1  = 10
erf.plot_file_1 = plt
erf.plot_vars_1 = density x_velocity y_velocity z_velocity theta rhoadv_0
erf.v = 0
amr.v = 0

# ---------------------------------------------------------------------------
# Master control
# ---------------------------------------------------------------------------
# Enable the dust model [Boolean]
erf.dust.enable = false

# Print per-step dust diagnostics to stdout [Boolean]
erf.dust.dust_debug = false

# Dust grid refinement factor in x and y; every atmosphere box length must
# divide by it, and it must equal erf.fire.grid_ratio when the fire coupling
# is on [Integer > 0]
erf.dust.grid_ratio = 1

# Number of particle size bins; each bin is one component of the emission
# flux [Integer > 0]
erf.dust.n_size_bins = 3

# Representative aerodynamic diameter per bin [µm]; bin 0 sets the Bagnold
# base threshold [Reals]
erf.dust.bin_diameter_um = 7.0 3.5 0.7

# Per-bin diameter [m] for settling, deposition and PM classification; the
# last value repeats when shorter than n_size_bins [Reals]
erf.dust.bin_diameters = 7.0e-6 2.5e-6 50.0e-6

# Bulk particle density [kg/m³] [Real > 0]
erf.dust.particle_density = 2650.0

# Air density used in the threshold and saltation flux [kg/m³] [Real > 0]
erf.dust.rho_air = 1.225

# Roughness length of the emitting surface [m], used by the log-law friction
# velocity of the terrain-corrected wind [Real > 0]
erf.dust.z0_dust = 0.01

# Height at which the wind is taken from the atmosphere [m]; set equal to
# erf.most.zref [Real > 0]
erf.dust.zref = 10.0

# ---------------------------------------------------------------------------
# Surface state
# ---------------------------------------------------------------------------
# Surface silt mass fraction [-] [Real 0-1]
erf.dust.silt_fraction = 0.10

# Surface crust strength index; 0 loose, 1 fully crusted [Real 0-1]
erf.dust.crust_index = 0.0

# Bagnold threshold coefficient A [-] [Real > 0]
erf.dust.threshold_A_coeff = 0.0123

# Base threshold friction velocity before the modifiers [m/s]; negative
# computes the Bagnold value from bin 0 at startup [Real]
erf.dust.ustar_t_base = -1.0

# Crust factor on the threshold: f_chem carries (1 + alpha_crust *
# crust_index) [Real >= 0]
erf.dust.alpha_crust = 0.5

# Efflorescence factor on the threshold: (1 + alpha_efflor * efflorescence)
# [Real >= 0]
erf.dust.alpha_efflor = 0.3

# Soil type raster; codes 1-16 STATSGO, 100-104 mine surfaces [String]
erf.dust.soil_type_file = ""

# Silt fraction raster; empty keeps silt_fraction [String]
erf.dust.silt_fraction_file = ""

# Crust index raster; empty keeps crust_index [String]
erf.dust.crust_index_file = ""

# Surface moisture inhibition raster in [0,1]; empty means dry [String]
erf.dust.moisture_flag_file = ""

# Suppression agent coverage raster in [0,1]; empty means none [String]
erf.dust.suppression_file = ""

# Read but not consumed; the five rasters above carry the surface state
# [String]
erf.dust.surface_map_file = ""

# Fine-grid terrain raster for the dust slopes; empty differences the
# atmosphere's nodal terrain [String]
erf.dust.terrain_file = ""

# ---------------------------------------------------------------------------
# Wind and terrain
# ---------------------------------------------------------------------------
# Apply the FARSITE terrain correction to the wind at zref and recompute u*
# from it by the log law [Boolean]
erf.dust.use_terrain_wind = false

# Ridge speed-up factor of the terrain correction [Real]
erf.dust.k_ridge = 1.5

# Lee-side shelter factor [Real]
erf.dust.k_shelter = 0.6

# Valley channelling factor [Real]
erf.dust.k_valley = 0.8

# Deflection of the wind vector toward the slope [Real]
erf.dust.k_deflect = 0.3

# Uniform friction velocity when no atmosphere is coupled [m/s]; 0 gives no
# emission [Real >= 0]
erf.dust.test_ustar = 0.0

# Surface temperature placeholder [K] [Real]
erf.dust.test_surf_temp_K = 293.15

# Wind speed placeholder at zref [m/s] [Real]
erf.dust.test_wind_speed = 5.0

# ---------------------------------------------------------------------------
# PHREEQC geochemistry
# ---------------------------------------------------------------------------
# PHREEQC output table (.csv with a header row; a .nc path aborts); empty
# disables the reader [String]
erf.dust.phreeqc_output_file = ""

# Interval between re-reads [s] [Real > 0]
erf.dust.phreeqc_update_interval_s = 86400.0

# Column holding the crust index [String]
erf.dust.phreeqc_crust_var = "crust_index"

# Column holding the silt fraction [String]
erf.dust.phreeqc_silt_var = "silt_fraction"

# Column holding the efflorescence fraction [String]
erf.dust.phreeqc_efflor_var = "efflorescence"

# Column holding the suppression modifier [String]
erf.dust.phreeqc_supp_var = "suppression_mod"

# Column holding the toxic-metal mass fraction of bin 0 [String]
erf.dust.phreeqc_metal_var = "metal_as_bin0"

# Names of the mine sites; empty means a single global table [Strings]
# erf.dust.site_names =

# Per-site PHREEQC table; an empty entry uses the global table [Strings]
# erf.dust.site_phreeqc_files =

# Site bounding-box lower x [m], one per site [Reals]
# erf.dust.site_x_lo =

# Site bounding-box lower y [m] [Reals]
# erf.dust.site_y_lo =

# Site bounding-box upper x [m] [Reals]
# erf.dust.site_x_hi =

# Site bounding-box upper y [m]; the last site listed wins where boxes
# overlap [Reals]
# erf.dust.site_y_hi =

# Interval for writing the deposition field back for PHREEQC [s]; 0 writes
# only at the end of the run [Real >= 0]
erf.dust.phreeqc_feedback_interval_s = 0.0

# Deposition grid file, overwritten at each write [String]
erf.dust.phreeqc_feedback_file = "dust_dep_feedback.dat"

# Per-site deposition CSV, appended at each write [String]
erf.dust.phreeqc_site_summary_file = "dust_dep_site_summary.csv"

# ---------------------------------------------------------------------------
# Scheduled sources and suppression
# ---------------------------------------------------------------------------
# Blast schedule CSV; empty means no blasts [String]
erf.dust.blast_schedule_file = ""

# Multiplier on the injected blast mass for fresh surfaces [-] [Real >= 1]
erf.dust.blast_reactivity = 2.0

# Haul road schedule CSV; empty means no road emission [String]
erf.dust.road_schedule_file = ""

# Per-road emission CSV [String]
erf.dust.road_diag_file = "dust_road_diag.csv"

# Base decay time of the suppression agent coverage [s]; about 3600 for
# water, 43200 for MgCl2 [Real > 0]
erf.dust.supp_tau_base_s = 3600.0

# ---------------------------------------------------------------------------
# Atmosphere coupling
# ---------------------------------------------------------------------------
# Scale on the injected flux; 0 disables injection for surface-only
# diagnostics [Real 0-1]
erf.dust.atm_feedback = 1.0

# One 3D scalar per bin instead of a single total; only bin 0 is returned to
# the surface at present [Boolean]
erf.dust.transport_bins_separately = false

# Surface collection efficiency of the dry-deposition resistance [-]; 3e-3
# bare mine surface, 1e-4 paved road, 1e-2 vegetation [Real > 0]
erf.dust.deposition_E0 = 3.0e-3

# Shao (2001) loading feedback on the threshold [m³/kg]; 0 disables [Real >=
# 0]
erf.dust.loading_feedback_coeff = 0.0

# Derive the moisture inhibition from the surface moisture flux (needs a
# moisture scheme; harmless without one) [Boolean]
erf.dust.use_dynamic_moisture = false

# Turbulent Schmidt number of the dust scalar in the MRF scheme, read from
# the erf prefix; 0 or negative uses the Prandtl number so dust diffuses
# like heat [Real]
erf.dust_mrf_Sc_t = 0.0

# ---------------------------------------------------------------------------
# Fire coupling (ERF-Hazard)
# ---------------------------------------------------------------------------
# Enable the fire-dust coupling; requires erf.dust.grid_ratio =
# erf.fire.grid_ratio [Boolean]
erf.fire_dust_coupling = false

# Fraction of the crust index removed in burned cells each step [Real 0-1]
erf.fire_dust_crust_reduction = 0.8

# Raise the dust u* to the log-law value of the fire's effective wind where
# that is larger [Boolean]
erf.fire_dust_wind_to_dust = true

# Roughness length of that log law [m] [Real > 0]
erf.fire_dust_wind_z0 = 0.1

# Reference height of that log law [m]; match erf.fire.wind_ref_ht [Real >
# 0]
erf.fire_dust_wind_zref = 6.1

# Multiply the emission flux by the convective lofting factor of the fire
# heat flux [Boolean]
erf.fire_dust_lofting_enabled = false

# Maximum lofting enhancement [-] [Real >= 0]
erf.fire_dust_lofting_k_loft = 2.0

# Fire heat flux below which there is no lofting [W/m²] [Real >= 0]
erf.fire_dust_lofting_Q_threshold = 50.0

# Heat flux scale of the lofting factor [W/m²]; 0 or negative disables it
# [Real]
erf.fire_dust_lofting_Q_ref = 500.0

# ---------------------------------------------------------------------------
# Output and diagnostics
# ---------------------------------------------------------------------------
# Steps between dust plotfiles; -1 disables, 0 writes only at the final step
# [Integer]
erf.dust.dust_plot_int = -1

# Dust plotfile prefix [String]
erf.dust.dust_plot_prefix = "plt_dust_"

# Per-step domain statistics CSV [String]
erf.dust.dust_diag_file = "dust_diag.dat"

# EPA NAAQS PM2.5 and PM10 CSV [String]
erf.dust.dust_naaqs_file = "dust_naaqs.csv"

# MSHA permissible exposure limit on the 8-hour TWA [mg/m³] [Real > 0]
erf.dust.msha_pel_mg_m3 = 5.0

# Shift length after which the dose resets [s] [Real > 0]
erf.dust.msha_shift_duration_s = 28800.0

# Per-step exposure CSV [String]
erf.dust.msha_exposure_file = "msha_exposure.csv"

# End-of-shift summary CSV [String]
erf.dust.msha_shift_file = "msha_shift_summary.csv"

# Receptor point names; one CSV per receptor [Strings]
# erf.dust.msha_receptor_names =

# Receptor x [m], one per name [Reals]
# erf.dust.msha_receptor_x =

# Receptor y [m], one per name [Reals]
# erf.dust.msha_receptor_y =

# Critical-material mass fraction per bin [kg/kg]; empty disables the
# budget, the last value repeats [Reals]
# erf.dust.cm_fractions =

# Critical-material budget CSV [String]
erf.dust.cm_budget_file = "dust_cm_budget.csv"

# Koschmieder visibility from PM10 [Boolean]
erf.dust.visibility_enable = false

# Mass extinction coefficient [m²/kg] [Real > 0]
erf.dust.visibility_k_ext = 4.0e3

# Haul-road closure threshold [m] [Real > 0]
erf.dust.visibility_road_closure_m = 300.0

# Reduced-visibility warning threshold [m] [Real > 0]
erf.dust.visibility_warning_m = 1000.0

# Visibility CSV [String]
erf.dust.visibility_diag_file = "visibility_diag.csv"

# Respirable crystalline silica from PM10 [Boolean]
erf.dust.silica_enable = false

# Silica mass fraction of the dust [-] [Real 0-1]
erf.dust.silica_fraction_rcs = 0.04

# OSHA PEL for quartz [mg/m³] [Real > 0]
erf.dust.silica_osha_pel_mg_m3 = 0.05

# Silica CSV [String]
erf.dust.silica_diag_file = "silica_diag.csv"

# Short-term exposure limit on the running PM10 average [Boolean]
erf.dust.stel_enable = false

# STEL threshold [mg/m³] [Real > 0]
erf.dust.stel_threshold_mg_m3 = 10.0

# STEL averaging period [s] [Real > 0]
erf.dust.stel_averaging_s = 900.0

# STEL CSV [String]
erf.dust.stel_diag_file = "stel_diag.csv"

# Release Lagrangian super-particles from emitting cells; needs
# ERF_ENABLE_PARTICLES [Boolean]
erf.dust.enable_particles = false

# Steps between particle releases [Integer > 0]
erf.dust.particle_release_interval = 1

