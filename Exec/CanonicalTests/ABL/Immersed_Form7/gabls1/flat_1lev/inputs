# GABLS1 stable ABL, surface cooling 0.25 K/h: flat ground (surface layer at z = 0), single level, dz = 20 m; k-eqn RANS, anelastic MidPoint, implicit vertical diffusion, FFT
erf.prob_name = "ABL"
stop_time = 32400.0
max_step  = -1
amrex.fpe_trap_invalid = 1
fabarray.mfiter_tile_size = 1024 1024 1024

geometry.prob_lo     = 0.0 0.0 0.0
geometry.prob_hi     = 160.0 160.0 400.0
amr.n_cell           = 8 8 20
amr.max_grid_size    = 256
amr.blocking_factor  = 2
amr.max_level        = 0
geometry.is_periodic = 1 1 0

zlo.type    = "surface_layer"
erf.most.z0 = 0.1
erf.dirichlet_k = true    # wall k from u* (AL01 Eq. 16), as erf.if_wall_tke in the immersed cases
erf.most.surf_temp         = 265.0
erf.most.surf_heating_rate = -0.25   # K/h, GABLS1
zhi.type       = "SlipWall"
zhi.theta_grad = 0.01

# anelastic, implicit vertical diffusion (solved in the first MidPoint stage)
erf.anelastic      = 1
erf.anelastic_type = MidPoint
erf.vert_implicit  = true
erf.use_fft        = true    # FFT Poisson solve (flat, periodic in x and y)
erf.fixed_dt       = 1.0

erf.init_type           = "input_sounding"
erf.input_sounding_file = "input_sounding"
erf.sounding_type       = "Ideal"

erf.sum_interval    = 60
erf.v               = 1
amr.v               = 0
erf.data_log        = surf_hist.dat mean_profiles.dat flux_profiles.dat sfs_profiles.dat
erf.profile_int     = 600
erf.destag_profiles = false

erf.check_file  = chk
erf.check_int   = -1
erf.plot_file_1 = plt
erf.plot_int_1  = 10800
erf.plot_vars_1 = density x_velocity y_velocity z_velocity theta KE Kmv Khv Lturb walldist diss Rt

erf.dycore_horiz_adv_type  = "Upwind_5th"
erf.dycore_vert_adv_type   = "Upwind_3rd"
erf.dryscal_horiz_adv_type = "Upwind_5th"
erf.dryscal_vert_adv_type  = "Upwind_3rd"

erf.use_gravity  = true
erf.use_coriolis = true
erf.coriolis_3d  = false
erf.latitude     = 90.0
erf.rotational_time_period = 90405.5439881955
erf.abl_driver_type = "GeostrophicWind"
erf.abl_geo_wind    = 8.0 0.0 0.0

# top sponge toward the sounding (10 m/s), as the kynema-sgf deck; dampcoef * dt = 0.05

erf.molec_diff_type = "None"
erf.les_type        = "None"
erf.rans_type       = "kEqn"
erf.theta_ref       = 300.0

# same initial k in every case: 0.84 m2/s2, linear decay to zero at 900 m above z = 0
prob.KE_0            = 0.4
prob.KE_decay_height = 250.0
prob.KE_decay_order  = 1
prob.pert_deltaU  = 0.0
prob.pert_deltaV  = 0.0
prob.T_0_Pert_Mag = 0.0
prob.U_0_Pert_Mag = 0.0
prob.V_0_Pert_Mag = 0.0
prob.W_0_Pert_Mag = 0.0
