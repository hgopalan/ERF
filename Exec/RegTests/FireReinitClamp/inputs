# FireReinitClamp: erf.fire.levelset.reinit_clamp, old against new, on the
# LevelSetPropagation fire (flat ground, 5 m/s wind along x, 10 m fire cells,
# a 30 m ignition disc, passive coupling) with a stronger reinitialisation
# than the default: 2 pseudo-time steps of 2.5 m (0.25 dx) every 5th subcycle
# (the default reinit_every). First-order differences and a viscosity of 4 m
# (0.4 dx, far below the stability limit at cfl 0.04) everywhere: the advection then
# raises phi where eps lap(phi) exceeds the Godunov |grad phi| (at the burned
# minimum of the disc, where that norm is 0), which a clamp run with
# reinit_iters = 0 would cut back. run_reinit_clamp.sh runs it 24 steps of 5 s (120 s)
# at levelset.cfl 0.04, so each step takes 4 level-set subcycles and the clamp's
# start-of-subcycle reference differs from the field at the start of the step, with each clamp, and with reinit_iters = 0 under
# each clamp; check_reinit_clamp.py compares the fire_phi fields.

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1000.0 1000.0 500.0
amr.n_cell = 20 20 16
geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.blocking_factor = 2
amr.max_grid_size = 10      # four 10-cell boxes: each divides by grid_ratio 5 on any rank count
amr.max_grid_size_z = 16    # fire module forbids z-decomposition

zlo.type = "surface_layer"
zhi.type = "SlipWall"
erf.most.z0 = 0.1
erf.most.surf_temp = 300.0
erf.most.surf_heating_rate = 0.0

erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.use_gravity = true
erf.use_coriolis = false
erf.theta_ref = 300.0

erf.init_type = "input_sounding"
erf.input_sounding_file = "input_sounding"
erf.sounding_type = Ideal

erf.fixed_dt = 5.0
max_step = 24
stop_time = 120.0

erf.v = 0
amr.v = 0
erf.sum_interval = -1
erf.check_int = -1
erf.plot_int_1 = -1
erf.fire_plot_int = 24
erf.fire_plot_file = "plt_fire_"

erf.fire.enable = true
erf.fire.propagation_method = "levelset"
erf.fire.grid_ratio = 5               # 10 m fire cells
erf.fire.fuel_model_id = 1            # short grass, uniform
erf.fire.ignition_x = 500.0
erf.fire.ignition_y = 500.0
erf.fire.ignition_r = 30.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.use_terrain_wind = false
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.10
erf.fire.coupling_type = "passive"    # one-way: the atmosphere never sees the fire

erf.fire.levelset.cfl = 0.04   # 4 subcycles per 5 s step (the level-set rate here is about 0.3 m/s)
erf.fire.levelset.gradient = "upwind"
erf.fire.levelset.eps_visc = 4.0
erf.fire.levelset.eps_visc_front = -1.0    # eps_visc everywhere
erf.fire.levelset.reinit_every = 5
erf.fire.levelset.reinit_iters = 2
erf.fire.levelset.reinit_dtau = 2.5
# erf.fire.levelset.reinit_clamp is set on the command line by run_reinit_clamp.sh
