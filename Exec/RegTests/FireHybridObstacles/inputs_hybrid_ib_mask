FILE = inputs_base

# Immersed-forcing buildings from the same heightmap the structure selector reads
erf.buildings_type = ImmersedForcing
erf.buildings_file_name = buildings_5m_64x32.txt
erf.immersed_forcing_substep = true
eb2.small_volfrac = 0.005
erf.if_Cd_momentum = 500.0
erf.if_Cd_scalar   = 50.0

erf.fire.ros_model = "hybrid"
erf.fire.hybrid.primary   = "rothermel"
erf.fire.hybrid.secondary = "balbi"
erf.fire.hybrid.selector  = "structure"
erf.fire.hybrid.structure_file = "buildings_5m_64x32.txt"
erf.fire.hybrid.structure_distance = 10.0

# Structures as non-burnable cells: the fire goes around the boxes
erf.fire.structures.enable = true
erf.fire.structures.file = "buildings_5m_64x32.txt"
erf.fire.fuel_map.nonburnable_codes = 0
