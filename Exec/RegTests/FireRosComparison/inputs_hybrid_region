FILE = inputs_base

# Rothermel upwind of x = 800 m, Balbi 2020 downwind of it. The line sits at
# the downwind edge of the ignition disc (centre 700 m, radius 100 m), so the
# head fire spreads at the Balbi rate from the start while the flanks and the
# backing fire stay at the Rothermel rate.
erf.fire.ros_model = "hybrid"
erf.fire.directional_ros = false
erf.fire.hybrid.primary   = "rothermel"
erf.fire.hybrid.secondary = "balbi"
erf.fire.hybrid.selector  = "region"
erf.fire.hybrid.region    = 800.0 0.0 2000.0 2000.0
erf.fire.balbi.formulation = "2020"
