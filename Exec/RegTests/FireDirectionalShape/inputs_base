# FireDirectionalShape: settings shared by the decks in this folder. A point
# ignition in a uniform wind on flat ground, spread by the directional level set.
#
# The atmosphere is a uniform westerly from input_sounding over a periodic domain
# with no diffusion and one-way coupling, so it stays uniform and the fire sees
# the same midflame wind everywhere and at all times. Short grass (Anderson fuel
# model 1) at 5.5 % moisture, 2 m fire cells, a 10 m ignition disc.

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 600.0 200.0 100.0
amr.n_cell = 30 10 5
geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 10      # box lengths must divide by the fire grid ratio
amr.max_grid_size_z = 5     # the fire module forbids z-decomposition

zlo.type = "surface_layer"  # the fire module needs the surface layer at the ground
zhi.type = "SlipWall"
# Zero bulk transfer coefficients: no surface drag, so the wind does not decay
# (with MOST it fell from 1.33 to 0.79 m/s at 6.1 m in 1500 s).
erf.surface_layer.flux_type = "bulk_coeff"
erf.most.Cd = 0.0
erf.most.Ch = 0.0
erf.most.Cq = 0.0
erf.most.surf_temp = 300.0
erf.most.surf_moist = 0.0

# The surface layer needs a diffusion operator; zero coefficients keep it idle.
erf.molec_diff_type = "ConstantAlpha"
erf.dynamic_viscosity = 0.0
erf.alpha_T = 0.0
erf.alpha_C = 0.0
erf.les_type = "None"

erf.init_type = "input_sounding"
erf.input_sounding_file = "input_sounding"
erf.sounding_type = Ideal
erf.use_gravity = true
erf.use_coriolis = false
erf.theta_ref = 300.0

erf.fixed_dt = 1.0                    # one-way and uniform, so the atmosphere stays put
erf.substepping_cfl = 0.5
max_step = 1500
stop_time = 1500.0
erf.v = 0
amr.v = 0
erf.sum_interval = -1
erf.check_int = -1
erf.plot_int_1 = -1
erf.fire_plot_file = "plt_fire_"
erf.fire_plot_int = 750               # 750 s and 1500 s: the wind must not change between them

erf.fire.enable = true
erf.fire.grid_ratio = 10              # 2 m fire cells
erf.fire.propagation_method = "levelset"
erf.fire.ros_model = "rothermel"
erf.fire.coupling_type = "passive"    # one-way: the atmosphere never sees the fire
erf.fire.fuel_model_id = 1            # short grass
erf.fire.moisture_1hr = 0.055
erf.fire.moisture_10hr = 0.055
erf.fire.moisture_100hr = 0.055
erf.fire.moisture_dynamic = false
erf.fire.use_waf = false              # the fire takes the wind at wind_ref_ht as its midflame wind
erf.fire.use_terrain_wind = false
erf.fire.write_fire_stats_csv = false
erf.fire.ignition_x = 100.0
erf.fire.ignition_y = 100.0
erf.fire.ignition_r = 10.0
