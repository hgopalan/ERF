# FireWrfWindCoupling: a finite ignition line under a strong, spatially-uniform
# wind, testing erf.fire.directional_wind_coupling ("projection", the default,
# vs "wrf"). See README.md for the physics; this deck holds everything the
# three variants (inputs_default, inputs_projection, inputs_wrf) share.
#
# The scenario is FireLineIgnition's Munoz-Esparza-et-al.-style finite line
# (a 1 km line, well short of the periodic extent, so the fire develops real
# lateral flanks), with a wind strong enough to make Rothermel's wind term
# sharply non-convex: phi_w (B - 1) = 76.8 at U = 4.005 m/s for FM1 at 6 %
# moisture. erf.fire.use_wind_limit = false lifts the 300 ft/min midflame-wind
# cap the code applies to fine fuels, which would otherwise clip this wind
# before phi_w sees it.
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 6000.0 3000.0 500.0
amr.n_cell = 120 60 20
geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 30
amr.max_grid_size_z = 20

zlo.type = "surface_layer"
zhi.type = "SlipWall"
erf.most.z0 = 0.01
erf.most.surf_temp = 300.0
erf.most.surf_heating_rate = 0.0

erf.molec_diff_type = "None"
erf.les_type = "Smagorinsky"
erf.Cs = 0.1
erf.use_gravity = true
erf.use_coriolis = false
erf.theta_ref = 300.0

erf.init_type = "input_sounding"
erf.sounding_type = Ideal
erf.input_sounding_file = "input_sounding"

erf.fixed_dt = 1.0
erf.substepping_cfl = 0.5
max_step = 100000
stop_time = 2100.0

erf.v = 0
amr.v = 0
erf.sum_interval = -1
erf.check_int = -1
erf.plot_int = -1
erf.fire_plot_int = 30

erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 2                    # 25 m fire cells
erf.fire.propagation_method = "levelset"
erf.fire.directional_ros = true            # head/backing/flanks from the front-normal projection
erf.fire.fuel_model_id = 1                 # short grass
erf.fire.moisture_1hr = 0.06
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.10
erf.fire.moisture_dynamic = false
erf.fire.ignition_r = 0.0                  # no point ignition: the polyline is the only source
erf.fire.ignition_x = 0.0
erf.fire.ignition_y = 0.0
erf.fire.ignition.polygon_file = "line_finite.csv"
erf.fire.ignition.polygon_type = "polyline"
erf.fire.ignition.polyline_width = 25.0    # one fire cell wide
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = false
erf.fire.use_wind_limit = false            # see header: keeps the full 4.005 m/s in phi_w
erf.fire.use_terrain_wind = false
erf.fire.ros_model = "rothermel"
erf.fire.write_fire_stats_csv = true
erf.fire.coupling_type = "lagged"
erf.fire.fire_atm_feedback = 0.0           # one-way: isolates level-set numerics

# Constant wind bypassing atmospheric interpolation, so all three variants see
# exactly the same wind field regardless of surface-layer drag: U = 4.005 m/s,
# chosen (with FM1 at 6 % moisture) to give Rothermel's head rate Rf = 1.701 m/s.
erf.fire.prescribed_wind   = true
erf.fire.prescribed_wind_x = 4.005
erf.fire.prescribed_wind_y = 0.0
