FILE = inputs_base

# Immersed-forcing buildings, mask, open-column wind weights.
# Immersed-forcing buildings from the same heightmap the mask reads
erf.buildings_type = ImmersedForcing
erf.buildings_file_name = buildings_5m_64x32.txt
erf.immersed_forcing_substep = true
eb2.small_volfrac = 0.005
erf.if_Cd_momentum = 500.0
erf.if_Cd_scalar   = 50.0

# Structures and the street as non-burnable cells
erf.fire.structures.enable = true
erf.fire.structures.file = "buildings_5m_64x32.txt"
erf.fire.fuel_map.nonburnable_codes = 0

# Bilinear wind weights renormalised over the columns open at the wind height
erf.fire.structures.wind_open_columns = true
