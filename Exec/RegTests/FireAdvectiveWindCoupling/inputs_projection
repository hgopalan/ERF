# The default written out explicitly. Must reproduce inputs_default's
# fire_phi bit for bit -- this is the pre-fix formulation:
# phi_w evaluated from the wind already projected onto the front normal,
# R(n) = R0(1 + phi_w(max(U.n,0))). Non-convex once phi_w(B-1) > 1 (here 76.8),
# so a finite line's head falls toward the Wulff-shape tip rate rather than
# tracking Rothermel's head rate. See README.md.
erf.fire.directional_wind_coupling = "projection"
erf.fire_plot_file           = "plt_fire_projection_"
erf.fire.fire_stats_csv_file = "fire_stats_projection.csv"
