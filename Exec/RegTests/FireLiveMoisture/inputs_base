# FireLiveMoisture: a grass fire in dry air under BEHAVE with dynamic fuel
# moisture, the live classes advanced by the legacy update (the default of
# erf.fire.moisture_live_model) or held at erf.fire.moisture_live ("fixed").
# One-way coupling, so the atmosphere is the same in every deck.

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 320.0 160.0 160.0
amr.n_cell = 64 32 32
geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 32      # box lengths must divide by grid_ratio
amr.max_grid_size_z = 32    # fire module forbids z-decomposition

zlo.type = "surface_layer"
zhi.type = "SlipWall"
erf.most.z0 = 0.1
erf.most.surf_temp = 300.0
erf.most.surf_heating_rate = 0.0

erf.molec_diff_type = "None"
erf.les_type = "Smagorinsky"
erf.Cs = 0.1
erf.use_gravity = true
erf.use_coriolis = false
erf.theta_ref = 300.0

erf.init_type = "input_sounding"
erf.input_sounding_file = "input_sounding"
erf.sounding_type = Ideal

erf.fixed_dt = 0.125
erf.substepping_cfl = 0.5
max_step = 100000
stop_time = 60.0

erf.v = 0
amr.v = 0
erf.sum_interval = -1
erf.check_int = -1
# (erf.plot_int, set here before 2026-09-10, was read by nothing; ERF reads
# erf.plot_int_1, and no atmosphere plotfile is still the intent.)
erf.plot_int_1 = -1
erf.fire_plot_int = 480              # fire plotfiles at 0 and 60 s: the moisture classes and the front are compared there

erf.fire.enable = true
erf.fire.grid_ratio = 4               # 1.25 m fire cells
erf.fire.propagation_method = "levelset"
erf.fire.directional_ros = false      # the per-cell BEHAVE path, which reads each cell's five moisture classes
erf.fire.ros_model = "behave"
erf.fire.fuel_model_id = 2            # timber grass and understory: a live herbaceous load for BEHAVE's live-to-dead transfer
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.08
erf.fire.moisture_live = 0.90         # as ROS_Models/inputs_fire_phase13_behave_dynamic
erf.fire.moisture_dynamic = true      # the dead classes dry toward the dry air's equilibrium
erf.fire.ignition_x = 100.0
erf.fire.ignition_y = 80.0
erf.fire.ignition_r = 15.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = true
erf.fire.use_terrain_wind = false
erf.fire.write_fire_stats_csv = false
erf.fire.coupling_type = "lagged"
erf.fire.inject_latent = true
erf.fire.fire_atm_feedback = 0.0      # one-way: the atmosphere is identical in every deck
