FILE = inputs_base

# Same as inputs_exposure_straight but stops at step 197 (98.5 s) and writes chk00197; the step is not a
# multiple of the reinitialisation or spotting intervals, so the restart also
# checks that the counters behind those schedules come back.
erf.fire.ros_model = "balbi"
erf.fire.balbi.formulation = "2020"
erf.fire.directional_ros = true
erf.fire.propagation_method = "levelset"
erf.fire.coupling_type = "passive"
erf.fire.structures.enable = true
erf.fire.structures.file = "buildings_25m_80x80.txt"
erf.fire.levelset.wall_extrapolate = true
erf.fire.exposure.enable = true
erf.fire.exposure.interval = 1
erf.fire.exposure.file = "exposure_chk.csv"
stop_time = 200.0
max_step = 197
erf.check_int = 197
