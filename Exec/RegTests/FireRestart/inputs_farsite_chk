FILE = inputs_base

# Same as inputs_farsite_straight but stops at step 197 (98.5 s) and writes chk00197; the step is not a
# multiple of the reinitialisation or spotting intervals, so the restart also
# checks that the counters behind those schedules come back.
erf.fire.ros_model = "rothermel"
erf.fire.propagation_method = "farsite"
erf.fire.coupling_type = "passive"
stop_time = 200.0
max_step = 197
erf.check_int = 197
