# FarsiteDefault: a fire on flat ground with the default FARSITE (Lagrangian
# point-stamping) propagation. 1 km x 1 km domain of 50 m atmosphere cells with
# a 5x fire grid (10 m fire cells), neutral 5 m/s wind along x from
# input_sounding, 120 s of passive spread from a 30 m ignition disc.
# LevelSetPropagation is the same set-up on the level-set path.

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1000.0 1000.0 500.0
amr.n_cell = 20 20 16
geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.blocking_factor = 2
amr.max_grid_size = 10      # four 10-cell boxes: each divides by grid_ratio 5 on any rank count
amr.max_grid_size_z = 16    # fire module forbids z-decomposition

zlo.type = "surface_layer"
zhi.type = "SlipWall"
erf.most.z0 = 0.1
erf.most.surf_temp = 300.0
erf.most.surf_heating_rate = 0.0

erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"
erf.use_gravity = true
erf.use_coriolis = false
erf.theta_ref = 300.0

erf.init_type = "input_sounding"
erf.input_sounding_file = "input_sounding"
erf.sounding_type = Ideal

erf.fixed_dt = 0.5
max_step = 1200
stop_time = 120.0

erf.v = 0
amr.v = 0
erf.sum_interval = -1
erf.check_int = -1
erf.plot_int = -1
erf.fire_plot_int = 240
erf.fire_plot_file = "plt_fire_"

erf.fire.enable = true
erf.fire.propagation_method = "farsite"
erf.fire.grid_ratio = 5               # 10 m fire cells
erf.fire.fuel_model_id = 1            # short grass, uniform
erf.fire.ignition_x = 500.0
erf.fire.ignition_y = 500.0
erf.fire.ignition_r = 30.0
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = true
erf.fire.use_terrain_wind = false
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.10
erf.fire.coupling_type = "passive"    # one-way: the atmosphere never sees the fire

# FARSITE parameters (defaults written out)
erf.fire.farsite.cfl_fire = 0.5
