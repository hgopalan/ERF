# FireSuppression: fire lines, retardant drops, the hold test and burnout
# from a watched action file (erf.fire.suppression.*).
#
# A still atmosphere on a 400 x 400 m domain with slip walls, 2 m fire cells
# (grid ratio 10 on 20 m atmospheric cells) and a prescribed rate of spread of
# 1 m/s, so the front moves exactly one cell a second and every arrival time
# follows from the geometry. A disc of radius 10 m at (200, 200) is ignited at
# t = 0; unsuppressed, its east edge reaches x = 230 m at the end of the 20 s
# run. Every variant differs only in its action file (and the poll and
# restart variants in their step counts); the propagation method is set here
# to the level set and overridden on the command line for the FARSITE path.

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 400.0 400.0 500.0
amr.n_cell = 20 20 10
geometry.is_periodic = 0 0 0
amr.max_level = 0
amr.max_grid_size = 10      # box lengths must divide by the fire grid ratio
amr.max_grid_size_z = 10    # the fire module forbids z-decomposition

xlo.type = "SlipWall"
xhi.type = "SlipWall"
ylo.type = "SlipWall"
yhi.type = "SlipWall"
zlo.type = "surface_layer"            # the fire module needs the surface layer at the ground
zhi.type = "SlipWall"
erf.most.z0 = 0.1
erf.most.surf_temp = 300.0
erf.most.surf_heating_rate = 0.0

# The surface layer needs a diffusion operator; zero coefficients keep the air
# free of it, so nothing but the fire changes the state.
erf.molec_diff_type = "ConstantAlpha"
erf.dynamic_viscosity = 0.0
erf.alpha_T = 0.0
erf.alpha_C = 0.0
erf.les_type = "None"
erf.use_coriolis = false
erf.theta_ref = 300.0
erf.init_type = "uniform"
erf.use_gravity = false
erf.fixed_dt = 0.5
erf.substepping_cfl = 0.5
erf.v = 0
amr.v = 0
erf.sum_interval = -1
erf.check_int = -1
erf.plot_int_1 = -1
erf.fire_plot_int = 40
erf.fire_plot_file = "plt_fire_"
max_step = 40
stop_time = 20.0

erf.fire.enable = true
erf.fire.grid_ratio = 10              # 2 m fire cells
erf.fire.propagation_method = "levelset"
erf.fire.ros_model = "prescribed"
erf.fire.prescribed.ros = 1.0
erf.fire.coupling_type = "passive"
erf.fire.fuel_model_id = 1
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.10
erf.fire.moisture_dynamic = false
erf.fire.use_waf = false
erf.fire.use_terrain_wind = false
erf.fire.ignition_x = 200.0
erf.fire.ignition_y = 200.0
erf.fire.ignition_r = 10.0
erf.fire.write_fire_stats_csv = false
erf.fire.boundary_guard_action = "none"
erf.fire.edge_reach_check = false

erf.fire.suppression.enable = true
erf.fire.suppression.poll_interval = 0     # read once at start; the poll variant polls
