# FireLevelsetReinit: does erf.fire.levelset.reinit_every/reinit_iters (level-
# set reinitialization) actually improve front-tracking accuracy over a
# short, uncoupled, single-fuel windy line fire, relative to no reinit at
# all? See README.md.
#
# One-way coupled (erf.fire.fire_atm_feedback = 0) with a constant prescribed
# wind (erf.fire.prescribed_wind), so the fire sees exactly the same wind
# regardless of atmospheric state -- this isolates level-set numerics from
# atmosphere/fire feedback entirely. Single fuel model (FM1, short grass).
# Every ROS/reinit setting here is ERF's own compiled-in default: no
# WRF-Fire-matching options (reaction_velocity_formula, wrf_bmst_compat,
# directional_wind_coupling) are touched.
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 6000.0 3000.0 500.0
amr.n_cell = 120 60 20
geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 30
amr.max_grid_size_z = 20

zlo.type = "surface_layer"
zhi.type = "SlipWall"
erf.most.z0 = 0.01
erf.most.surf_temp = 300.0
erf.most.surf_heating_rate = 0.0

erf.molec_diff_type = "None"
erf.les_type = "Smagorinsky"
erf.Cs = 0.1
erf.use_gravity = true
erf.use_coriolis = false
erf.theta_ref = 300.0

erf.init_type = "input_sounding"
erf.sounding_type = Ideal
erf.input_sounding_file = "input_sounding"

erf.fixed_dt = 1.0
erf.substepping_cfl = 0.5
max_step = 100000
stop_time = 120.0

erf.v = 0
amr.v = 0
erf.sum_interval = -1
erf.check_int = -1
erf.plot_int = -1
erf.fire_plot_int = 120         # only need t=0 and t=120 (the whole run)

erf.fire.enable = true
erf.fire.fire_debug = true
erf.fire.grid_ratio = 2                    # 25 m fire cells
erf.fire.propagation_method = "levelset"
erf.fire.directional_ros = true            # head/backing/flanks from the front-normal projection
erf.fire.fuel_model_id = 1                 # short grass (FM1), the only fuel used
erf.fire.moisture_1hr = 0.06
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.10
erf.fire.moisture_dynamic = false
erf.fire.ignition_r = 0.0                  # no additional disc: the polyline is the only intended source
# The primary point ignition (x/y/r) is *always* applied at t=0 regardless of
# ignition_r -- r=0 is a zero-radius seed, not "off," and the level set's
# isotropic backing rate (R0>0) still nucleates it into its own separate fire.
# Placed on the polyline's own midpoint so it's redundant with its footprint.
erf.fire.ignition_x = 500.0
erf.fire.ignition_y = 1500.0
erf.fire.ignition.polygon_file = "line_finite.csv"
erf.fire.ignition.polygon_type = "polyline"
erf.fire.ignition.polyline_width = 25.0    # one fire cell wide
erf.fire.wind_ref_ht = 6.1
erf.fire.use_waf = false
erf.fire.use_wind_limit = false            # keeps the theoretical Rf calc a simple closed form
erf.fire.use_terrain_wind = false
erf.fire.ros_model = "rothermel"
erf.fire.write_fire_stats_csv = true
erf.fire.coupling_type = "lagged"
erf.fire.fire_atm_feedback = 0.0           # one-way: isolates level-set numerics

# Constant prescribed wind, bypassing atmospheric interpolation entirely.
erf.fire.prescribed_wind   = true
erf.fire.prescribed_wind_x = 4.005
erf.fire.prescribed_wind_y = 0.0
