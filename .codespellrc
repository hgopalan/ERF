[codespell]
skip = .git,*.ipynb,*.bib,*.ps,*.patch,*~,CHANGES,*/Submodules,*/tmp_build_dir,Cell_D_*,*.F90,./Docs/sphinx_doc/NoahmpTable.TBL,./Exec/RegTests/NoahMP_Ideal/NoahmpTable.TBL,./Docs/sphinx_doc/namelist.erf,./Exec/CanonicalTests/MovingBodies/IEA15_land_model/*.dat,./Exec/CanonicalTests/MovingBodies/IEA15_land_model/*.fst,./Exec/CanonicalTests/MovingBodies/IEA15_land_model/IEA-15-240-RWT
ignore-words = .codespell-ignore-words
uri-ignore-words-list = *