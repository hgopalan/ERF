ifeq ($(USE_LNG), TRUE)
  DEFINES += -DERF_USE_LNG

  # Compiled source files
  CEXE_sources += LNG/ERF_LNGGrid.cpp
  CEXE_sources += LNG/ERF_LNGPrerequisites.cpp
  CEXE_sources += LNG/ERF_LNGLayer.cpp
  CEXE_sources += LNG/ERF_LNGEvaporation.cpp
  CEXE_sources += LNG/ERF_LNGPool.cpp
  CEXE_sources += LNG/ERF_LNGAtmCoupling.cpp
  CEXE_sources += LNG/ERF_LNGWindExtract.cpp
  CEXE_sources += LNG/ERF_LNGGravityCurrent.cpp
  CEXE_sources += LNG/ERF_LNGFlammability.cpp
  CEXE_sources += LNG/ERF_LNGPlotfile.cpp

  # Header files (inlines and templates)
  CEXE_headers += LNG/ERF_LNGParams.H
  CEXE_headers += LNG/ERF_LNGGrid.H
  CEXE_headers += LNG/ERF_LNGPrerequisites.H
  CEXE_headers += LNG/ERF_LNGAtmCoupling.H
  CEXE_headers += LNG/ERF_LNGWindExtract.H
  CEXE_headers += LNG/ERF_LNGAtmReturn.H
  CEXE_headers += LNG/ERF_LNGPlotfile.H
  CEXE_headers += LNG/ERF_LNGPlotfileCatalog.H
  CEXE_headers += LNG/ERF_LNGReceptorOutput.H
  CEXE_headers += LNG/ERF_LNGStatsOutput.H
  CEXE_headers += LNG/ERF_LNGLayer.H
  CEXE_headers += LNG/ERF_LNGEvaporation.H
  CEXE_headers += LNG/ERF_LNGPool.H
  CEXE_headers += LNG/ERF_LNGGravityCurrent.H
  CEXE_headers += LNG/ERF_LNGFlammability.H

endif
