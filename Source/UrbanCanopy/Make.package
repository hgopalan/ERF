ifeq ($(USE_UCM), TRUE)
  DEFINES += -DERF_USE_UCM

  # Critical ordering: Grid and Prerequisites first (initialization dependency)
  CEXE_sources += UrbanCanopy/ERF_UCMGrid.cpp
  CEXE_sources += UrbanCanopy/ERF_UCMPrerequisites.cpp
  CEXE_sources += UrbanCanopy/ERF_UCMParams.cpp
  CEXE_sources += UrbanCanopy/ERF_UCMAllocate.cpp
  CEXE_sources += UrbanCanopy/ERF_UCM.cpp
  # Phase 1.3 additions
  CEXE_sources += UrbanCanopy/ERF_UCMWindExtract.cpp
  CEXE_sources += UrbanCanopy/ERF_UCMLayer.cpp
  # Phase 1.4 additions
  CEXE_sources += UrbanCanopy/ERF_UCMAtmCoupling.cpp
  CEXE_sources += UrbanCanopy/ERF_UCMPlotfile.cpp
  CEXE_sources += UrbanCanopy/ERF_UCMDiagnostics.cpp
  # Phase 2.5 additions (ATM-grid plumbing)
  CEXE_sources += UrbanCanopy/ERF_UCMAtmPlotfile.cpp
  # Phase 2.1 additions (CSV readers)
  CEXE_sources += UrbanCanopy/ERF_UCMBuildingLayoutReader.cpp
  CEXE_sources += UrbanCanopy/ERF_UCMMaterialRegistry.cpp
  # Phase 3.4 additions (Stability-aware canyon-atmosphere exchange)
  CEXE_sources += UrbanCanopy/ERF_UCMStabilityCorrection.cpp
  # Phase 4.2 additions (Cloud-aware radiation)
  CEXE_sources += UrbanCanopy/ERF_UCMCloudCSVReader.cpp
  # Phase 6.1 additions (tree layout + drag)
  CEXE_sources += UrbanCanopy/ERF_UCMTreeLayoutReader.cpp
  CEXE_sources += UrbanCanopy/ERF_UCMTreeDrag.cpp
  # Phase 6.2a additions (tree radiation)
  CEXE_sources += UrbanCanopy/ERF_UCMTreeRad.cpp
  # Phase 5.1a additions (View-factor precomputation)
  CEXE_sources += UrbanCanopy/ERF_UCMViewFactors.cpp
  # Phase 5.2 additions (HVAC waste heat)
  CEXE_sources += UrbanCanopy/ERF_UCMHVACReader.cpp
  CEXE_sources += UrbanCanopy/ERF_UCMOccupancyReader.cpp

  # Headers (complete list)
  CEXE_headers += UrbanCanopy/ERF_UCM.H
  CEXE_headers += UrbanCanopy/ERF_UCMParams.H
  CEXE_headers += UrbanCanopy/ERF_UCMGrid.H
  CEXE_headers += UrbanCanopy/ERF_UCMFields.H
  CEXE_headers += UrbanCanopy/ERF_UCMAllocate.H
  CEXE_headers += UrbanCanopy/ERF_UCMPrerequisites.H
  # Phase 1.3 header-only and interface headers
  CEXE_headers += UrbanCanopy/ERF_UCMWindExtract.H
  CEXE_headers += UrbanCanopy/ERF_UCMSlabConduction.H
  CEXE_headers += UrbanCanopy/ERF_UCMSEBSolver.H
  CEXE_headers += UrbanCanopy/ERF_UCMSEBSolver4Var.H
  CEXE_headers += UrbanCanopy/ERF_UCMLayer.H
  # Phase 1.4 headers
  CEXE_headers += UrbanCanopy/ERF_UCMAtmCoupling.H
  CEXE_headers += UrbanCanopy/ERF_UCMPlotfile.H
  CEXE_headers += UrbanCanopy/ERF_UCMDiagnostics.H
  CEXE_headers += UrbanCanopy/ERF_UCMPlotfileCatalog.H
  # Phase 2.5 headers (ATM-grid plumbing)
  CEXE_headers += UrbanCanopy/ERF_UCMAtmPlotfile.H
  # Phase 2.1 headers (CSV readers)
  CEXE_headers += UrbanCanopy/ERF_UCMBuildingLayoutReader.H
  CEXE_headers += UrbanCanopy/ERF_UCMMaterialRegistry.H
  # Phase 3.4 headers (Stability-aware canyon-atmosphere exchange)
  CEXE_headers += UrbanCanopy/ERF_UCMStabilityCorrection.H
  # Phase 3.5b headers (Prescribed radiation forcing)
  CEXE_headers += UrbanCanopy/ERF_UCMRadiationForcing.H
  # Phase 4.2 headers (Cloud-aware radiation)
  CEXE_headers += UrbanCanopy/ERF_UCMCloudCSVReader.H
  # Phase 6.1 headers (tree layout + drag)
  CEXE_headers += UrbanCanopy/ERF_UCMTreeLayoutReader.H
  CEXE_headers += UrbanCanopy/ERF_UCMTreeDrag.H
  # Phase 5.1a headers (View-factor precomputation)
  CEXE_headers += UrbanCanopy/ERF_UCMViewFactors.H
  # Phase 4.3 headers (Real radiation extraction — placeholder)
  CEXE_headers += UrbanCanopy/ERF_UCMRadiationExtraction.H
  # Phase 5.1b headers (SW multi-bounce radiosity solver)
  CEXE_headers += UrbanCanopy/ERF_UCMRadiosity.H
  # Phase 5.1c headers (LW multi-bounce radiosity solver)
  CEXE_headers += UrbanCanopy/ERF_UCMRadiosityLW.H
  # Phase 5.2 headers (HVAC waste heat)
  CEXE_headers += UrbanCanopy/ERF_UCMHVAC.H
  CEXE_headers += UrbanCanopy/ERF_UCMHVACReader.H
  CEXE_headers += UrbanCanopy/ERF_UCMOccupancyReader.H
  # Phase 5.3 headers (Green roofs and permeable pavement)
  CEXE_headers += UrbanCanopy/ERF_UCMGreenRoof.H
  CEXE_headers += UrbanCanopy/ERF_UCMPermeableRoad.H
  # Phase 6.3 headers (Crown transpiration)
  CEXE_headers += UrbanCanopy/ERF_UCMCrownTranspiration.H

endif
